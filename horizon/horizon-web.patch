+fn stage(
+    module: &wgpu::ShaderModule,
+    entry_point: Option<&str>,
+    options: &wgpu::PipelineCompilationOptions<'_>,
+) -> Value {
+    let mut stage = json!({ "module": id_of!(module, WebShaderModule) });
+    if let Some(entry) = entry_point {
+        stage["entryPoint"] = json!(entry);
+    }
+    if !options.constants.is_empty() {
+        let constants: serde_json::Map<String, Value> = options
+            .constants
+            .iter()
+            .map(|(k, v)| ((*k).to_owned(), json!(v)))
+            .collect();
+        stage["constants"] = Value::Object(constants);
+    }
+    stage
+}
+
+fn render_pipeline(desc: &wgpu::RenderPipelineDescriptor<'_>) -> Value {
+    let layout = desc
+        .layout
+        .map_or(json!("auto"), |l| json!(id_of!(l, WebPipelineLayout)));
+    let mut vertex = stage(
+        desc.vertex.module,
+        desc.vertex.entry_point,
+        &desc.vertex.compilation_options,
+    );
+    vertex["buffers"] = desc
+        .vertex
+        .buffers
+        .iter()
+        .map(|b| {
+            let Some(b) = b else { return Value::Null };
+            json!({
+                "arrayStride": b.array_stride,
+                "stepMode": match b.step_mode {
+                    wgpu::VertexStepMode::Vertex => "vertex",
+                    wgpu::VertexStepMode::Instance => "instance",
+                },
+                "attributes": b.attributes.iter().map(|a| json!({
+                    "format": vertex_format(a.format),
+                    "offset": a.offset,
+                    "shaderLocation": a.shader_location,
+                })).collect::<Vec<_>>(),
+            })
+        })
+        .collect();
+    let p = &desc.primitive;
+    let mut primitive = json!({
+        "topology": primitive_topology(p.topology),
+        "frontFace": match p.front_face {
+            wgpu::FrontFace::Ccw => "ccw",
+            wgpu::FrontFace::Cw => "cw",
+        },
+        "cullMode": match p.cull_mode {
+            None => "none",
+            Some(wgpu::Face::Front) => "front",
+            Some(wgpu::Face::Back) => "back",
+        },
+        "unclippedDepth": p.unclipped_depth,
+    });
+    if let Some(format) = p.strip_index_format {
+        primitive["stripIndexFormat"] = json!(index_format(format));
+    }
+    let mut pipeline = json!({
+        "label": desc.label,
+        "layout": layout,
+        "vertex": vertex,
+        "primitive": primitive,
+        "multisample": {
+            "count": desc.multisample.count,
+            "mask": desc.multisample.mask as u32,
+            "alphaToCoverageEnabled": desc.multisample.alpha_to_coverage_enabled,
+        },
+    });
+    if let Some(ds) = &desc.depth_stencil {
+        let face = |f: &wgpu::StencilFaceState| {
+            json!({
+                "compare": compare_function(f.compare),
+                "failOp": stencil_operation(f.fail_op),
+                "depthFailOp": stencil_operation(f.depth_fail_op),
+                "passOp": stencil_operation(f.pass_op),
+            })
+        };
+        let mut state = json!({
+            "format": texture_format(ds.format),
+            "stencilFront": face(&ds.stencil.front),
+            "stencilBack": face(&ds.stencil.back),
+            "stencilReadMask": ds.stencil.read_mask,
+            "stencilWriteMask": ds.stencil.write_mask,
+            "depthBias": ds.bias.constant,
+            "depthBiasSlopeScale": ds.bias.slope_scale,
+            "depthBiasClamp": ds.bias.clamp,
+        });
+        if let Some(write) = ds.depth_write_enabled {
+            state["depthWriteEnabled"] = json!(write);
+        }
+        if let Some(compare) = ds.depth_compare {
+            state["depthCompare"] = json!(compare_function(compare));
+        }
+        pipeline["depthStencil"] = state;
+    }
+    if let Some(fragment) = &desc.fragment {
+        let mut state = stage(
+            fragment.module,
+            fragment.entry_point,
+            &fragment.compilation_options,
+        );
+        state["targets"] = fragment
+            .targets
+            .iter()
+            .map(|target| {
+                target.as_ref().map(|t| {
+                    let mut target = json!({
+                        "format": texture_format(t.format),
+                        "writeMask": t.write_mask.bits(),
+                    });
+                    if let Some(blend) = t.blend {
+                        let component = |c: wgpu::BlendComponent| {
+                            json!({
+                                "srcFactor": blend_factor(c.src_factor),
+                                "dstFactor": blend_factor(c.dst_factor),
+                                "operation": blend_operation(c.operation),
+                            })
+                        };
+                        target["blend"] = json!({ "color": component(blend.color), "alpha": component(blend.alpha) });
+                    }
+                    target
+                })
+            })
+            .collect();
+        pipeline["fragment"] = state;
+    }
+    pipeline
+}
