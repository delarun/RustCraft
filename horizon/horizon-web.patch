+impl Drop for Window {
+    fn drop(&mut self) {
+        let mut windows = self.windows.lock().unwrap();
+        windows.live.retain(|&id| id != self.id);
+        windows.destroyed.push(self.id);
+        // SAFETY: a plain value.
+        unsafe { super::window_destroy(self.id.0 as u32) };
+    }
