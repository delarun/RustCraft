+//! wgpu on the page's WebGPU, as a wgpu custom backend: every object is a
+//! WebGPU object in the worker that renders (launcher/src/jvm/gpu.ts in the
+//! RustCraft launcher), named by a number. wgpu's objects are neither `Send`
+//! nor `Sync` on this target, so they are all made and used on that thread.
+//!
+//! Descriptors cross as JSON, in WebGPU's own shape with objects as numbers;
+//! a pass's commands are recorded here and replayed by one call when it ends.
+//! Waiting (adapters, devices, mapping, error scopes, presenting) suspends the
+//! thread (JSPI), so wgpu's futures are ready when they are returned.
+
+use std::any::Any;
+use std::cell::{Cell, RefCell};
+use std::fmt;
+use std::future::ready;
+use std::ops::Range;
+use std::pin::Pin;
+use std::sync::Arc;
+
+use serde_json::{Value, json};
+use wgpu::custom::*;
+
+mod convert;
+use convert::*;
+
+mod ffi {
+    #[link(wasm_import_module = "rc_gpu")]
+    unsafe extern "C" {
