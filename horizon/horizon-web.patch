+    fn create_pipeline_layout(
+        &self,
+        desc: &wgpu::PipelineLayoutDescriptor<'_>,
+    ) -> DispatchPipelineLayout {
+        let layouts: Vec<Option<u32>> = desc
+            .bind_group_layouts
+            .iter()
+            .map(|l| l.map(|l| id_of!(l, WebBindGroupLayout)))
+            .collect();
+        let id = create(
+            self.h.0,
+            Kind::PipelineLayout,
+            &json!({ "label": desc.label, "bindGroupLayouts": layouts }),
+        );
+        DispatchPipelineLayout::custom(WebPipelineLayout { h: handle(id) })
+    }
+
+    fn create_render_pipeline(
+        &self,
+        desc: &wgpu::RenderPipelineDescriptor<'_>,
+    ) -> DispatchRenderPipeline {
+        let id = create(self.h.0, Kind::RenderPipeline, &render_pipeline(desc));
+        DispatchRenderPipeline::custom(WebRenderPipeline { h: handle(id) })
+    }
+
+    fn create_mesh_pipeline(
+        &self,
+        _desc: &wgpu::MeshPipelineDescriptor<'_>,
+    ) -> DispatchRenderPipeline {
+        panic!("WebGPU has no mesh shaders")
+    }
+
+    fn create_compute_pipeline(
+        &self,
+        desc: &wgpu::ComputePipelineDescriptor<'_>,
+    ) -> DispatchComputePipeline {
+        let layout = desc
+            .layout
+            .map_or(json!("auto"), |l| json!(id_of!(l, WebPipelineLayout)));
+        let id = create(
+            self.h.0,
+            Kind::ComputePipeline,
+            &json!({
+                "label": desc.label,
+                "layout": layout,
+                "compute": stage(desc.module, desc.entry_point, &desc.compilation_options),
+            }),
+        );
+        DispatchComputePipeline::custom(WebComputePipeline { h: handle(id) })
+    }
+
+    unsafe fn create_pipeline_cache(
+        &self,
+        _desc: &wgpu::PipelineCacheDescriptor<'_>,
+    ) -> DispatchPipelineCache {
+        DispatchPipelineCache::custom(WebPipelineCache)
+    }
+
+    fn create_buffer(&self, desc: &wgpu::BufferDescriptor<'_>) -> DispatchBuffer {
+        let id = create(
+            self.h.0,
+            Kind::Buffer,
+            &json!({
+                "label": desc.label,
+                // WebGPU wants sizes a multiple of 4 when mapped at creation.
+                "size": if desc.mapped_at_creation { desc.size.next_multiple_of(4) } else { desc.size },
+                "usage": desc.usage.bits() & 0x3ff,
+                "mappedAtCreation": desc.mapped_at_creation,
+            }),
+        );
+        let buffer = WebBuffer {
+            h: handle(id),
+            map_mode: Rc::new(Cell::new(0)),
+        };
+        if desc.mapped_at_creation {
+            buffer.map_mode.set(MAP_WRITE);
+        }
+        DispatchBuffer::custom(buffer)
+    }
+
