+/// A WebGPU object: forgotten when the last of its holders drops it.
+struct Handle(u32);
+
+impl Drop for Handle {
+    fn drop(&mut self) {
+        // SAFETY: a plain value.
+        unsafe { ffi::release(self.0) };
+    }
+}
+
+impl fmt::Debug for Handle {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(f, "#{}", self.0)
+    }
+}
+
+type H = Arc<Handle>;
+
+fn handle(id: u32) -> H {
+    Arc::new(Handle(id))
+}
+
+/// An object id from a descriptor's reference to one of ours.
+macro_rules! id_of {
+    ($value:expr, $ty:ty) => {
+        $value
+            .as_custom::<$ty>()
+            .expect(concat!("not a web ", stringify!($ty)))
+            .h
+            .0
+    };
+}
+
+/// Objects of the same kind compare by identity.
+macro_rules! object {
+    ($name:ident { $($field:ident: $ty:ty),* $(,)? }) => {
+        #[derive(Debug, Clone)]
+        pub struct $name {
+            h: H,
+            $($field: $ty,)*
+        }
+        impl PartialEq for $name {
+            fn eq(&self, other: &Self) -> bool {
+                Arc::ptr_eq(&self.h, &other.h)
+            }
+        }
+        impl Eq for $name {}
+        impl PartialOrd for $name {
+            fn partial_cmp(&self, other: &Self) -> Option<std::cmp::Ordering> {
+                Some(self.cmp(other))
+            }
+        }
+        impl Ord for $name {
+            fn cmp(&self, other: &Self) -> std::cmp::Ordering {
+                Arc::as_ptr(&self.h).cmp(&Arc::as_ptr(&other.h))
+            }
+        }
+        impl std::hash::Hash for $name {
+            fn hash<S: std::hash::Hasher>(&self, state: &mut S) {
+                Arc::as_ptr(&self.h).hash(state)
+            }
+        }
+    };
+}
