+//! Child processes in the RustCraft launcher (wasm32-wasip1-threads), which WASI lacks: the page
+//! runs each as a process of its own (the launcher's JVM, rjava, for `java`) on the same files,
+//! and serves calls of the `rc_proc` import (launcher/src/jvm/children.ts). A call names its
+//! operation in JSON and returns through a cell in this program's memory, which the page writes
+//! and wakes; the import waits for it.
+
+use crate::pyjson::{self, Value};
+use std::fs;
+use std::io::{Read, Write};
+use std::path::Path;
+use std::sync::atomic::{AtomicI32, Ordering};
+use std::sync::{Arc, Mutex};
+
+#[link(wasm_import_module = "rc_proc")]
+extern "C" {
+    fn call(request: *const u8, length: usize, buffer: *mut u8, capacity: usize, cell: *mut i32);
+}
+
+const PENDING: i32 = i32::MIN;
+
+fn request(fields: Vec<(&str, Value)>, buffer: *mut u8, capacity: usize) -> i32 {
+    let mut object = Value::Object(Vec::new());
+    for (key, value) in fields {
+        object.insert(key, value);
+    }
+    let text = pyjson::dumps(&object, &pyjson::COMPACT);
+    let cell = AtomicI32::new(PENDING);
+    // SAFETY: the page writes `buffer` (at most `capacity` bytes) and then `cell`; the import
+    // returns once `cell` is written (it waits on it), and neither is touched after.
+    unsafe { call(text.as_ptr(), text.len(), buffer, capacity, cell.as_ptr()) };
+    cell.load(Ordering::Acquire)
+}
+
+fn number(n: i32) -> Value {
+    Value::Int(n.to_string())
+}
+
+/// A running child: its id at the page.
+pub(crate) struct Child(i32);
+
+impl Child {
+    /// Starts `program` (`java`) with `args` in `cwd`; its stdin is a pipe from `write`.
+    pub(crate) fn spawn(program: &str, args: &[String], cwd: &Path) -> std::io::Result<Child> {
+        let cwd = std::path::absolute(cwd)?;
+        let id = request(
+            vec![
+                ("op", Value::Str("spawn".into())),
+                ("program", Value::Str(program.into())),
+                (
+                    "args",
+                    Value::Array(args.iter().cloned().map(Value::Str).collect()),
+                ),
+                ("cwd", Value::Str(cwd.to_string_lossy().into_owned())),
+            ],
+            std::ptr::null_mut(),
+            0,
+        );
+        if id <= 0 {
+            return Err(std::io::Error::other(format!(
+                "cannot start {program} (error {})",
+                -id
+            )));
+        }
+        Ok(Child(id))
+    }
+
+    fn simple(&self, op: &str, buffer: *mut u8, capacity: usize) -> i32 {
+        request(
+            vec![("op", Value::Str(op.into())), ("id", number(self.0))],
+            buffer,
+            capacity,
+        )
+    }
+
+    /// Reads the child's stdout (1) or stderr (2); 0 at its end.
+    pub(crate) fn read(&self, fd: i32, buffer: &mut [u8]) -> usize {
+        request(
+            vec![
+                ("op", Value::Str("read".into())),
+                ("id", number(self.0)),
+                ("fd", number(fd)),
+            ],
+            buffer.as_mut_ptr(),
+            buffer.len(),
+        )
+        .max(0) as usize
+    }
+
+    pub(crate) fn write(&self, data: &[u8]) {
+        self.simple("write", data.as_ptr().cast_mut(), data.len());
+    }
+
+    /// The exit status, once the child ended.
+    pub(crate) fn wait(&self) -> i32 {
+        self.simple("wait", std::ptr::null_mut(), 0)
+    }
+
+    pub(crate) fn kill(&self) {
+        self.simple("kill", std::ptr::null_mut(), 0);
+    }
+}
+
+impl Drop for Child {
+    fn drop(&mut self) {
+        self.simple("drop", std::ptr::null_mut(), 0);
+    }
+}
+
+/// Copies a stream of the child to `out` until it ends.
+fn drain(child: &Child, fd: i32, out: &Mutex<&fs::File>) {
+    let mut buffer = vec![0; 1 << 16];
+    loop {
+        let n = child.read(fd, &mut buffer);
+        if n == 0 {
+            return;
+        }
+        let _ = out.lock().unwrap().write_all(&buffer[..n]);
+    }
+}
+
+/// The biggest heap the launcher's VM has under wasm32: it, its tables and 64 thread stacks
+/// must fit in 2 GiB.
+const MAX_HEAP: &str = "-Xmx1536m";
+
+/// `java` arguments for the launcher's VM, which takes `-D`, `-Xmx` and `-cp` before the main
+/// class: `-jar` becomes the jar's `Main-Class`, and heaps over `MAX_HEAP` that.
+fn translate(args: &[String]) -> Result<Vec<String>, String> {
+    let mut translated = Vec::new();
+    let mut rest = args.iter();
+    while let Some(arg) = rest.next() {
+        if arg == "-jar" {
+            let jar = rest.next().ok_or("-jar needs a jar")?;
+            translated.extend(["-cp".to_string(), jar.clone(), main_class(Path::new(jar))?]);
+            translated.extend(rest.cloned());
+            break;
+        }
+        if let Some(size) = arg.strip_prefix("-Xmx") {
+            let lower = size.to_ascii_lowercase();
+            let megabytes = match lower.strip_suffix('g') {
+                Some(n) => n.parse::<u64>().map(|n| n * 1024),
+                None => lower.trim_end_matches('m').parse::<u64>(),
+            };
+            if megabytes.map_or(true, |m| m > 1536) {
+                translated.push(MAX_HEAP.into());
+                continue;
+            }
+        }
+        translated.push(arg.clone());
+        if arg == "-cp" || arg == "-classpath" {
+            translated.extend(rest.next().cloned());
+        }
+    }
+    Ok(translated)
+}
+
+/// `java <args>` as a child (`Jdk::java`), its output appended to `log`.
+pub(crate) fn java(args: &[String], cwd: Option<&Path>, log: &fs::File) -> Result<(), String> {
+    let translated = translate(args)?;
+    let cwd = cwd.map(Path::to_path_buf).unwrap_or_else(|| "/".into());
+    let child = Child::spawn("java", &translated, &cwd).map_err(|e| e.to_string())?;
+    let out = Mutex::new(log);
+    std::thread::scope(|scope| {
+        scope.spawn(|| drain(&child, 1, &out));
+        drain(&child, 2, &out);
+    });
+    match child.wait() {
+        0 => Ok(()),
+        code => Err(format!("java failed (exit status: {code})")),
+    }
+}
+
+fn main_class(jar: &Path) -> Result<String, String> {
+    let mut archive = crate::open_zip(jar)?;
+    let mut manifest = String::new();
+    archive
+        .by_name("META-INF/MANIFEST.MF")
+        .map_err(|e| format!("{}: {e}", jar.display()))?
+        .read_to_string(&mut manifest)
+        .map_err(|e| format!("{}: {e}", jar.display()))?;
+    manifest
+        .lines()
+        .find_map(|line| line.strip_prefix("Main-Class:"))
+        .map(|name| name.trim().to_string())
+        .ok_or_else(|| format!("{} names no Main-Class", jar.display()))
+}
+
+/// A child whose stdin the caller writes and whose stdout lines arrive on a channel
+/// (`worker::Worker`); its stderr goes to `log`.
+pub(crate) fn piped(
+    args: &[String],
+    cwd: &Path,
+    log: fs::File,
+) -> Result<
+    (
+        Arc<Child>,
+        std::sync::mpsc::Receiver<std::io::Result<String>>,
+    ),
+    String,
+> {
+    let child = Arc::new(Child::spawn("java", &translate(args)?, cwd).map_err(|e| e.to_string())?);
+    let errors = child.clone();
+    std::thread::spawn(move || drain(&errors, 2, &Mutex::new(&log)));
+    let (send, replies) = std::sync::mpsc::channel();
+    let output = child.clone();
+    std::thread::spawn(move || {
+        let mut buffer = vec![0; 1 << 16];
+        let mut line = Vec::new();
+        loop {
+            let n = output.read(1, &mut buffer);
+            if n == 0 {
+                return;
+            }
+            for &byte in &buffer[..n] {
+                if byte == b'\n' {
+                    let text = String::from_utf8_lossy(&line)
+                        .trim_end_matches('\r')
+                        .to_string();
+                    line.clear();
+                    if send.send(Ok(text)).is_err() {
+                        return;
+                    }
+                } else {
+                    line.push(byte);
+                }
+            }
+        }
+    });
+    Ok((child, replies))
+}
