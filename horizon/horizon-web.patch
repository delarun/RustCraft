@@ -0,0 +1,170 @@
+//! Windows in a worker of the RustCraft launcher (wasm32-wasip1-threads): a
+//! window is a canvas the page shows, input comes from the page as events.
+//! The page's side is launcher/src/jvm/display.ts, this thread's side the
+//! `rjava_web` imports (launcher/src/jvm/platform.ts), the same the JVM's SDL
+//! uses (vm/crates/jvm/src/web/sdl.rs).
+
+use std::fmt::{self, Display, Formatter};
+
+use smol_str::SmolStr;
+
+use crate::dpi::{PhysicalPosition, PhysicalSize};
+use crate::keyboard::Key;
+
+pub(crate) use self::event_loop::{ActiveEventLoop, EventLoop, EventLoopProxy, OwnedDisplayHandle};
+mod event_loop;
+
+pub use self::window::Window;
+mod window;
+
+#[link(wasm_import_module = "rjava_web")]
+extern "C" {
+    /// Creates canvas `id` (a window) of `width`×`height` CSS pixels.
+    fn window_create(id: u32, width: i32, height: i32, visible: bool);
+    fn window_destroy(id: u32);
+    fn window_show(id: u32, visible: bool);
+    fn window_title(id: u32, title: *const u8, length: usize);
+    /// The page's state: [CSS width, CSS height, pixel width, pixel height,
+    /// device pixel ratio × 1000, focused, pointer locked, screen width,
+    /// screen height].
+    fn page_state(out: *mut i32);
+    /// The next input event (8 words, see `EventLoop::pump`); false if none.
+    fn event_next(out: *mut i32) -> bool;
+    /// A CSS cursor by index (display.ts `CURSORS`).
+    fn cursor_set(kind: i32);
+    /// Pointer lock: relative mouse motion, no cursor.
+    fn mouse_relative(enabled: bool);
+}
+
+/// The page's state (see `page_state`).
+#[derive(Clone, Copy, Debug)]
+pub(crate) struct Page {
+    pub css: (i32, i32),
+    pub pixels: (u32, u32),
+    pub scale: f64,
+    pub focused: bool,
+    pub screen: (u32, u32),
+}
+
+pub(crate) fn page() -> Page {
+    let mut out = [0i32; 9];
+    // SAFETY: the import writes 9 words.
+    unsafe { page_state(out.as_mut_ptr()) };
+    Page {
+        css: (out[0], out[1]),
+        pixels: (out[2].max(1) as u32, out[3].max(1) as u32),
+        scale: if out[4] > 0 { out[4] as f64 / 1000.0 } else { 1.0 },
+        focused: out[5] != 0,
+        screen: (out[7].max(1) as u32, out[8].max(1) as u32),
+    }
+}
+
+#[derive(Default, Debug, Copy, Clone, PartialEq, Eq, Hash)]
+pub(crate) struct PlatformSpecificEventLoopAttributes {}
+
+#[derive(Clone, Copy, Debug, Eq, Hash, Ord, PartialEq, PartialOrd)]
+pub struct WindowId(u64);
+
+impl WindowId {
+    pub const fn dummy() -> Self {
+        WindowId(u64::MAX)
+    }
+}
+
+impl From<WindowId> for u64 {
+    fn from(id: WindowId) -> Self {
+        id.0
+    }
+}
+
+impl From<u64> for WindowId {
+    fn from(id: u64) -> Self {
+        Self(id)
+    }
+}
+
+#[derive(Clone, Copy, Debug, Eq, Hash, Ord, PartialEq, PartialOrd)]
+pub struct DeviceId;
+
+impl DeviceId {
+    pub const fn dummy() -> Self {
+        DeviceId
+    }
+}
+
+#[derive(Clone, Copy, Debug, Default, Eq, PartialEq)]
+pub struct PlatformSpecificWindowAttributes;
+
+#[derive(Clone, Debug)]
+pub struct OsError(&'static str);
+
+impl Display for OsError {
+    fn fmt(&self, fmt: &mut Formatter<'_>) -> Result<(), fmt::Error> {
+        fmt.write_str(self.0)
+    }
+}
+
+pub(crate) use crate::cursor::{
+    NoCustomCursor as PlatformCustomCursor, NoCustomCursor as PlatformCustomCursorSource,
+};
+pub(crate) use crate::icon::NoIcon as PlatformIcon;
+
+/// The screen the page is on.
+#[derive(Clone, Debug, Eq, Hash, Ord, PartialEq, PartialOrd)]
+pub struct MonitorHandle;
+
+impl MonitorHandle {
+    pub fn name(&self) -> Option<String> {
+        Some("Browser".to_owned())
+    }
+
+    pub fn size(&self) -> PhysicalSize<u32> {
+        page().screen.into()
+    }
+
+    pub fn position(&self) -> PhysicalPosition<i32> {
+        (0, 0).into()
+    }
+
+    pub fn scale_factor(&self) -> f64 {
+        page().scale
+    }
+
+    pub fn refresh_rate_millihertz(&self) -> Option<u32> {
+        None
+    }
+
+    pub fn video_modes(&self) -> impl Iterator<Item = VideoModeHandle> {
+        std::iter::once(VideoModeHandle { size: self.size().into(), monitor: self.clone() })
+    }
+}
+
+#[derive(Clone, Debug, Eq, Hash, PartialEq)]
+pub struct VideoModeHandle {
+    size: (u32, u32),
+    monitor: MonitorHandle,
+}
+
+impl VideoModeHandle {
+    pub fn size(&self) -> PhysicalSize<u32> {
+        self.size.into()
+    }
+
+    pub fn bit_depth(&self) -> u16 {
+        32
+    }
+
+    pub fn refresh_rate_millihertz(&self) -> u32 {
+        60000
+    }
+
+    pub fn monitor(&self) -> MonitorHandle {
+        self.monitor.clone()
+    }
+}
+
+#[derive(Debug, Clone, Eq, PartialEq, Hash)]
+pub struct KeyEventExtra {
+    pub key_without_modifiers: Key,
+    pub text_with_all_modifiers: Option<SmolStr>,
+}
diff --git a/third_party/winit/src/platform_impl/wasi/window.rs b/third_party/winit/src/platform_impl/wasi/window.rs
