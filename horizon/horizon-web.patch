+/// What a device knows of its adapter.
+#[derive(Debug, Clone)]
+struct Capabilities {
+    features: wgpu::Features,
+    limits: wgpu::Limits,
+    info: wgpu::AdapterInfo,
+}
+
+object!(WebAdapter { caps: Capabilities });
+
+impl WebAdapter {
+    fn new(h: H) -> Self {
+        let id = h.0;
+        // SAFETY: the host writes at most `cap` bytes.
+        let json = host_string(|out, cap| unsafe { ffi::adapter_info(id, out, cap) });
+        let info: Value = serde_json::from_str(&json).unwrap_or(Value::Null);
+        let caps = Capabilities {
+            features: features_from_web(&info["features"]),
+            limits: limits_from_web(&info["limits"]),
+            info: wgpu::AdapterInfo {
+                name: info["description"]
+                    .as_str()
+                    .filter(|s| !s.is_empty())
+                    .unwrap_or("WebGPU")
+                    .to_owned(),
+                vendor: 0,
+                device: 0,
+                device_type: if info["fallback"].as_bool() == Some(true) {
+                    wgpu::DeviceType::Cpu
+                } else {
+                    wgpu::DeviceType::Other
+                },
+                device_pci_bus_id: String::new(),
+                driver: info["vendor"].as_str().unwrap_or("").to_owned(),
+                driver_info: info["architecture"].as_str().unwrap_or("").to_owned(),
+                backend: wgpu::Backend::BrowserWebGpu,
+                subgroup_min_size: info["subgroupMinSize"].as_u64().unwrap_or(4) as u32,
+                subgroup_max_size: info["subgroupMaxSize"].as_u64().unwrap_or(128) as u32,
+                transient_saves_memory: None,
+                limit_bucket: None,
+            },
+        };
+        Self { h, caps }
+    }
+}
+
+impl AdapterInterface for WebAdapter {
+    fn request_device(
+        &self,
+        desc: &wgpu::DeviceDescriptor<'_>,
+    ) -> Pin<Box<dyn RequestDeviceFuture>> {
+        let features = desc.required_features & self.caps.features;
+        let json = json!({
+            "label": desc.label,
+            "requiredFeatures": features_to_web(features),
+            "requiredLimits": limits_to_web(&desc.required_limits),
+        })
+        .to_string();
+        // SAFETY: the bytes of a live string.
+        let id = unsafe { ffi::request_device(self.h.0, json.as_ptr(), json.len()) };
+        let result = if id == 0 {
+            // SAFETY: the host writes at most `cap` bytes.
+            let reason = host_string(|out, cap| unsafe { ffi::last_error(out, cap) });
+            log::error!("WebGPU device: {reason}");
+            Err(wgpu::RequestDeviceError::from_message(reason))
+        } else {
+            // SAFETY: a plain value.
+            let queue = handle(unsafe { ffi::device_queue(id) });
+            let caps = Capabilities {
+                features,
+                limits: desc.required_limits.clone(),
+                info: self.caps.info.clone(),
+            };
+            let device = WebDevice {
+                h: handle(id),
+                caps,
+                errors: Rc::default(),
+                scopes: Rc::default(),
+            };
+            let queue = WebQueue {
+                h: queue,
+                device: device.clone(),
+                submissions: Rc::default(),
+            };
+            Ok((DispatchDevice::custom(device), DispatchQueue::custom(queue)))
+        };
+        Box::pin(ready(result))
+    }
+
+    fn is_surface_supported(&self, _surface: &DispatchSurface) -> bool {
+        true
+    }
+
+    fn features(&self) -> wgpu::Features {
+        self.caps.features
+    }
+
+    fn limits(&self) -> wgpu::Limits {
+        self.caps.limits.clone()
+    }
+
+    fn downlevel_capabilities(&self) -> wgpu::DownlevelCapabilities {
+        wgpu::DownlevelCapabilities::default()
+    }
+
+    fn get_info(&self) -> wgpu::AdapterInfo {
+        self.caps.info.clone()
+    }
+
+    fn get_texture_format_features(
+        &self,
+        format: wgpu::TextureFormat,
+    ) -> wgpu::TextureFormatFeatures {
+        format.guaranteed_format_features(self.caps.features)
+    }
+
+    fn get_presentation_timestamp(&self) -> wgpu::PresentationTimestamp {
+        wgpu::PresentationTimestamp::INVALID_TIMESTAMP
+    }
+
+    fn cooperative_matrix_properties(&self) -> Vec<wgpu::wgt::CooperativeMatrixProperties> {
+        Vec::new()
+    }
+}
