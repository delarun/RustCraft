+/// Object kinds for `ffi::create`.
+#[repr(u32)]
+enum Kind {
+    Buffer = 1,
+    Texture = 2,
+    TextureView = 3,
+    Sampler = 4,
+    BindGroupLayout = 5,
+    BindGroup = 6,
+    PipelineLayout = 7,
+    ShaderModule = 8,
+    RenderPipeline = 9,
+    ComputePipeline = 10,
+    CommandEncoder = 11,
+    QuerySet = 12,
+}
+
+fn create(parent: u32, kind: Kind, desc: &Value) -> u32 {
+    let json = desc.to_string();
+    // SAFETY: the bytes of a live string.
+    unsafe { ffi::create(parent, kind as u32, json.as_ptr(), json.len()) }
+}
+
+/// A string the host writes into a buffer of ours, growing it when short.
+fn host_string(f: impl Fn(*mut u8, usize) -> usize) -> String {
+    let mut buffer = vec![0u8; 4096];
+    loop {
+        let len = f(buffer.as_mut_ptr(), buffer.len());
+        if len <= buffer.len() {
+            buffer.truncate(len);
+            return String::from_utf8_lossy(&buffer).into_owned();
+        }
+        buffer.resize(len, 0);
+    }
+}
+
+/// An error message the host writes, or none (-1).
+fn host_error(f: impl FnOnce(*mut u8, usize) -> isize) -> Option<String> {
+    let mut buffer = vec![0u8; 16384];
+    let len = f(buffer.as_mut_ptr(), buffer.len());
+    (len >= 0).then(|| {
+        buffer.truncate((len as usize).min(16384));
+        String::from_utf8_lossy(&buffer).into_owned()
+    })
+}
