+#[derive(Debug)]
+struct WebComputePass {
+    encoder: H,
+    desc: Value,
+    ops: Ops,
+}
+
+impl Drop for WebComputePass {
+    fn drop(&mut self) {
+        let json = self.desc.to_string();
+        let ops = &self.ops.words;
+        // SAFETY: the bytes and words of a live string and vector.
+        unsafe {
+            ffi::compute_pass(
+                self.encoder.0,
+                json.as_ptr(),
+                json.len(),
+                ops.as_ptr(),
+                ops.len(),
+            )
+        };
+    }
+}
+
+impl ComputePassInterface for WebComputePass {
+    fn set_pipeline(&mut self, pipeline: &DispatchComputePipeline) {
+        let id = self.ops.object::<()>(
+            &pipeline
+                .as_custom::<WebComputePipeline>()
+                .expect("not a web pipeline")
+                .h,
+        );
+        self.ops.op(SET_PIPELINE, &[id]);
+    }
+
+    fn set_bind_group(
+        &mut self,
+        index: u32,
+        bind_group: Option<&DispatchBindGroup>,
+        offsets: &[wgpu::DynamicOffset],
+    ) {
+        self.ops.set_bind_group(index, bind_group, offsets);
+    }
+
+    fn set_immediates(&mut self, _offset: u32, _data: &[u8]) {
+        panic!("WebGPU has no immediates")
+    }
+
+    fn insert_debug_marker(&mut self, _label: &str) {}
+    fn push_debug_group(&mut self, _group_label: &str) {}
+    fn pop_debug_group(&mut self) {}
+
+    fn write_timestamp(&mut self, _query_set: &DispatchQuerySet, _query_index: u32) {}
+    fn begin_pipeline_statistics_query(
+        &mut self,
+        _query_set: &DispatchQuerySet,
+        _query_index: u32,
+    ) {
+    }
+    fn end_pipeline_statistics_query(&mut self) {}
+
+    fn dispatch_workgroups(&mut self, x: u32, y: u32, z: u32) {
+        self.ops.op(DISPATCH, &[x, y, z]);
+    }
+
+    fn dispatch_workgroups_indirect(
+        &mut self,
+        indirect_buffer: &DispatchBuffer,
+        indirect_offset: wgpu::BufferAddress,
+    ) {
+        self.ops
+            .indirect(DISPATCH_INDIRECT, indirect_buffer, indirect_offset, 1, 12);
+    }
+
+    fn transition_resources<'a>(
+        &mut self,
+        _buffer_transitions: &mut dyn Iterator<
+            Item = wgpu::wgt::BufferTransition<&'a DispatchBuffer>,
+        >,
+        _texture_transitions: &mut dyn Iterator<
+            Item = wgpu::wgt::TextureTransition<&'a DispatchTextureView>,
+        >,
+    ) {
+    }
+}
+
+#[derive(Debug)]
+struct WebRenderBundleEncoder {
+    device: u32,
+    desc: Value,
+    ops: Ops,
+}
+
+impl RenderBundleEncoderInterface for WebRenderBundleEncoder {
+    fn set_pipeline(&mut self, pipeline: &DispatchRenderPipeline) {
+        self.ops.set_pipeline(pipeline);
+    }
+
+    fn set_bind_group(
+        &mut self,
+        index: u32,
+        bind_group: Option<&DispatchBindGroup>,
+        offsets: &[wgpu::DynamicOffset],
+    ) {
+        self.ops.set_bind_group(index, bind_group, offsets);
+    }
+
+    fn set_index_buffer(
+        &mut self,
+        buffer: &DispatchBuffer,
+        index_format: wgpu::IndexFormat,
+        offset: wgpu::BufferAddress,
+        size: Option<wgpu::BufferSize>,
+    ) {
+        self.ops
+            .set_index_buffer(buffer, index_format, offset, size);
+    }
+
+    fn set_vertex_buffer(
+        &mut self,
+        slot: u32,
+        buffer: Option<&DispatchBuffer>,
+        offset: wgpu::BufferAddress,
+        size: Option<wgpu::BufferSize>,
+    ) {
+        self.ops.set_vertex_buffer(slot, buffer, offset, size);
+    }
+
+    fn set_immediates(&mut self, _offset: u32, _data: &[u8]) {
+        panic!("WebGPU has no immediates")
+    }
+
+    fn draw(&mut self, vertices: Range<u32>, instances: Range<u32>) {
+        self.ops.draw(vertices, instances);
+    }
+
+    fn draw_indexed(&mut self, indices: Range<u32>, base_vertex: i32, instances: Range<u32>) {
+        self.ops.draw_indexed(indices, base_vertex, instances);
+    }
+
+    fn draw_indirect(
+        &mut self,
+        indirect_buffer: &DispatchBuffer,
+        indirect_offset: wgpu::BufferAddress,
+    ) {
+        self.ops
+            .indirect(DRAW_INDIRECT, indirect_buffer, indirect_offset, 1, 16);
+    }
+
+    fn draw_indexed_indirect(
+        &mut self,
+        indirect_buffer: &DispatchBuffer,
+        indirect_offset: wgpu::BufferAddress,
+    ) {
+        self.ops.indirect(
+            DRAW_INDEXED_INDIRECT,
+            indirect_buffer,
+            indirect_offset,
+            1,
+            20,
+        );
+    }
+
+    fn finish(self, desc: &wgpu::RenderBundleDescriptor<'_>) -> DispatchRenderBundle {
+        let mut json = self.desc;
+        json["bundleLabel"] = json!(desc.label);
+        let text = json.to_string();
+        let ops = &self.ops.words;
+        // SAFETY: the bytes and words of a live string and vector.
+        let id = unsafe {
+            ffi::render_bundle(
+                self.device,
+                text.as_ptr(),
+                text.len(),
+                ops.as_ptr(),
+                ops.len(),
+            )
+        };
+        DispatchRenderBundle::custom(WebRenderBundle { h: handle(id) })
+    }
+
+    fn finish_boxed(
+        self: Box<Self>,
+        desc: &wgpu::RenderBundleDescriptor<'_>,
+    ) -> DispatchRenderBundle {
+        (*self).finish(desc)
+    }
+}
