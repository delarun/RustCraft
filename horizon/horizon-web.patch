+/// A pass's recorded commands (gpu.ts `replay`) and the objects they name,
+/// kept alive until it is replayed.
+#[derive(Debug, Default)]
+struct Ops {
+    words: Vec<u32>,
+    keep: Vec<H>,
+}
+
+// Commands: an opcode, then its words (64-bit numbers as two, low first).
+const SET_PIPELINE: u32 = 1;
+const SET_BIND_GROUP: u32 = 2;
+const SET_INDEX_BUFFER: u32 = 3;
+const SET_VERTEX_BUFFER: u32 = 4;
+const SET_BLEND_CONSTANT: u32 = 5;
+const SET_SCISSOR_RECT: u32 = 6;
+const SET_VIEWPORT: u32 = 7;
+const SET_STENCIL_REFERENCE: u32 = 8;
+const DRAW: u32 = 9;
+const DRAW_INDEXED: u32 = 10;
+const DRAW_INDIRECT: u32 = 11;
+const DRAW_INDEXED_INDIRECT: u32 = 12;
+const EXECUTE_BUNDLES: u32 = 13;
+const BEGIN_OCCLUSION_QUERY: u32 = 14;
+const END_OCCLUSION_QUERY: u32 = 15;
+const DISPATCH: u32 = 16;
+const DISPATCH_INDIRECT: u32 = 17;
+
+impl Ops {
+    fn keep(&mut self, h: H) {
+        if self.keep.last().is_none_or(|last| !Arc::ptr_eq(last, &h)) {
+            self.keep.push(h);
+        }
+    }
+
+    fn op(&mut self, op: u32, args: &[u32]) {
+        self.words.push(op);
+        self.words.extend_from_slice(args);
+    }
+
+    fn u64(&mut self, v: u64) {
+        self.words.push(v as u32);
+        self.words.push((v >> 32) as u32);
+    }
+
+    fn object<T: Any>(&mut self, h: &H) -> u32 {
+        self.keep(h.clone());
+        h.0
+    }
+
+    fn set_pipeline(&mut self, pipeline: &DispatchRenderPipeline) {
+        let id = self.object::<()>(
+            &pipeline
+                .as_custom::<WebRenderPipeline>()
+                .expect("not a web pipeline")
+                .h,
+        );
+        self.op(SET_PIPELINE, &[id]);
+    }
+
+    fn set_bind_group(
+        &mut self,
+        index: u32,
+        bind_group: Option<&DispatchBindGroup>,
+        offsets: &[u32],
+    ) {
+        let id = bind_group.map_or(0, |g| {
+            self.object::<()>(
+                &g.as_custom::<WebBindGroup>()
+                    .expect("not a web bind group")
+                    .h,
+            )
+        });
+        self.op(SET_BIND_GROUP, &[index, id, offsets.len() as u32]);
+        self.words.extend_from_slice(offsets);
+    }
+
+    fn set_index_buffer(
+        &mut self,
+        buffer: &DispatchBuffer,
+        format: wgpu::IndexFormat,
+        offset: u64,
+        size: Option<wgpu::BufferSize>,
+    ) {
+        let id = self.object::<()>(&buffer.as_custom::<WebBuffer>().expect("not a web buffer").h);
+        let format = match format {
+            wgpu::IndexFormat::Uint16 => 0,
+            wgpu::IndexFormat::Uint32 => 1,
+        };
+        self.op(SET_INDEX_BUFFER, &[id, format, size.is_some() as u32]);
+        self.u64(offset);
+        self.u64(size.map_or(0, |s| s.get()));
+    }
+
+    fn set_vertex_buffer(
+        &mut self,
+        slot: u32,
+        buffer: Option<&DispatchBuffer>,
+        offset: u64,
+        size: Option<wgpu::BufferSize>,
+    ) {
+        let id = buffer.map_or(0, |b| {
+            self.object::<()>(&b.as_custom::<WebBuffer>().expect("not a web buffer").h)
+        });
+        self.op(SET_VERTEX_BUFFER, &[slot, id, size.is_some() as u32]);
+        self.u64(offset);
+        self.u64(size.map_or(0, |s| s.get()));
+    }
+
+    fn draw(&mut self, vertices: Range<u32>, instances: Range<u32>) {
+        self.op(
+            DRAW,
+            &[
+                vertices.end - vertices.start,
+                instances.end - instances.start,
+                vertices.start,
+                instances.start,
+            ],
+        );
+    }
+
+    fn draw_indexed(&mut self, indices: Range<u32>, base_vertex: i32, instances: Range<u32>) {
+        self.op(
+            DRAW_INDEXED,
+            &[
+                indices.end - indices.start,
+                instances.end - instances.start,
+                indices.start,
+                base_vertex as u32,
+                instances.start,
+            ],
+        );
+    }
+
+    fn indirect(&mut self, op: u32, buffer: &DispatchBuffer, offset: u64, count: u32, stride: u64) {
+        let id = self.object::<()>(&buffer.as_custom::<WebBuffer>().expect("not a web buffer").h);
+        for i in 0..count as u64 {
+            self.op(op, &[id]);
+            self.u64(offset + i * stride);
+        }
+    }
+}
+
+#[derive(Debug)]
+struct WebRenderPass {
+    encoder: H,
+    desc: Value,
+    ops: Ops,
+}
+
+impl Drop for WebRenderPass {
+    fn drop(&mut self) {
+        let json = self.desc.to_string();
+        let ops = &self.ops.words;
+        // SAFETY: the bytes and words of a live string and vector.
+        unsafe {
+            ffi::render_pass(
+                self.encoder.0,
+                json.as_ptr(),
+                json.len(),
+                ops.as_ptr(),
+                ops.len(),
+            )
+        };
+    }
+}
