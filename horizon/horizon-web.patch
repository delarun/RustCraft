+/// What the game's handler for errors outside a scope is.
+#[derive(Default)]
+struct ErrorSink(RefCell<Option<Arc<dyn wgpu::UncapturedErrorHandler>>>);
+
+impl fmt::Debug for ErrorSink {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
