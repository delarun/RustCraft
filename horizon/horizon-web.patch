--- /dev/null
+++ b/third_party/cpal/src/host/wasi/mod.rs
@@ -0,0 +1,263 @@
+//! Output in a worker of the RustCraft launcher (wasm32-wasip1-threads): a
+//! thread fills a ring of 48 kHz stereo f32 frames in the program's memory,
+//! which the page's AudioWorklet plays (launcher/src/jvm/audio.ts; the ring is
+//! the JVM's OpenAL one, vm/crates/jvm/src/web/al.rs). One device, output only.
+
+use std::sync::atomic::{AtomicBool, AtomicU32, Ordering};
+use std::sync::{Arc, OnceLock};
+use std::time::{Duration, Instant};
+
+use crate::traits::{DeviceTrait, HostTrait, StreamTrait};
+use crate::{
+    BuildStreamError, Data, DefaultStreamConfigError, DeviceNameError, DevicesError,
+    InputCallbackInfo, OutputCallbackInfo, OutputStreamTimestamp, PauseStreamError,
+    PlayStreamError, SampleFormat, SampleRate, StreamConfig, StreamError, StreamInstant,
+    SupportedBufferSize, SupportedStreamConfig, SupportedStreamConfigRange,
+    SupportedStreamConfigsError,
+};
+
+#[link(wasm_import_module = "rjava_web")]
+extern "C" {
+    /// Starts playback of the ring at `ring` (see `Ring`).
+    fn audio_start(ring: u32);
+}
+
+const RATE: u32 = 48_000;
+const CHANNELS: u16 = 2;
+/// Ring capacity in frames, and how far ahead the stream fills it.
+const RING_FRAMES: usize = 16_384;
+const AHEAD_FRAMES: u32 = 3_072;
+const CHUNK_FRAMES: usize = 256;
+
+/// The output ring: written by a stream's thread, read by the AudioWorklet.
+#[repr(C)]
+struct Ring {
+    /// Frames written and read, ever (wrapping).
+    written: AtomicU32,
+    read: AtomicU32,
+    capacity: u32,
+    rate: u32,
+    samples: [f32; RING_FRAMES * 2],
+}
+
+/// The page plays one ring for the whole program: made and handed over once.
+fn ring() -> &'static Ring {
+    static RING: OnceLock<&'static Ring> = OnceLock::new();
+    RING.get_or_init(|| {
+        let ring: &'static Ring = Box::leak(Box::new(Ring {
+            written: AtomicU32::new(0),
+            read: AtomicU32::new(0),
+            capacity: RING_FRAMES as u32,
+            rate: RATE,
+            samples: [0.0; RING_FRAMES * 2],
+        }));
+        // SAFETY: the ring lives forever.
+        unsafe { audio_start(ring as *const Ring as u32) };
+        ring
+    })
+}
+
+/// The stream writing the ring now: an older one stops when it changes.
+static GENERATION: AtomicU32 = AtomicU32::new(0);
+
+#[derive(Default)]
+pub struct Devices(bool);
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Device;
+
+pub struct Host;
+
+pub struct Stream {
+    playing: Arc<AtomicBool>,
+    generation: u32,
+}
+
+pub struct SupportedInputConfigs;
+pub struct SupportedOutputConfigs(bool);
+
+impl Host {
+    pub fn new() -> Result<Self, crate::HostUnavailable> {
+        Ok(Host)
+    }
+}
+
+impl Devices {
+    pub fn new() -> Result<Self, DevicesError> {
+        Ok(Devices(false))
+    }
+}
+
+fn range() -> SupportedStreamConfigRange {
+    SupportedStreamConfigRange::new(
+        CHANNELS,
+        SampleRate(RATE),
+        SampleRate(RATE),
+        SupportedBufferSize::Unknown,
+        SampleFormat::F32,
+    )
+}
+
+impl DeviceTrait for Device {
+    type SupportedInputConfigs = SupportedInputConfigs;
+    type SupportedOutputConfigs = SupportedOutputConfigs;
+    type Stream = Stream;
+
+    fn name(&self) -> Result<String, DeviceNameError> {
+        Ok("Browser".to_owned())
+    }
+
+    fn supported_input_configs(&self) -> Result<SupportedInputConfigs, SupportedStreamConfigsError> {
+        Ok(SupportedInputConfigs)
+    }
+
+    fn supported_output_configs(&self) -> Result<SupportedOutputConfigs, SupportedStreamConfigsError> {
+        Ok(SupportedOutputConfigs(false))
+    }
+
+    fn default_input_config(&self) -> Result<SupportedStreamConfig, DefaultStreamConfigError> {
+        Err(DefaultStreamConfigError::StreamTypeNotSupported)
+    }
+
+    fn default_output_config(&self) -> Result<SupportedStreamConfig, DefaultStreamConfigError> {
+        Ok(range().with_max_sample_rate())
+    }
+
+    fn build_input_stream_raw<D, E>(
+        &self,
+        _config: &StreamConfig,
+        _sample_format: SampleFormat,
+        _data_callback: D,
+        _error_callback: E,
+        _timeout: Option<Duration>,
+    ) -> Result<Self::Stream, BuildStreamError>
+    where
+        D: FnMut(&Data, &InputCallbackInfo) + Send + 'static,
+        E: FnMut(StreamError) + Send + 'static,
+    {
+        Err(BuildStreamError::StreamConfigNotSupported)
+    }
+
+    /// The callback runs on a thread of its own, a chunk at a time, keeping
+    /// the ring about 64 ms ahead of the page.
+    fn build_output_stream_raw<D, E>(
+        &self,
+        config: &StreamConfig,
+        sample_format: SampleFormat,
+        mut data_callback: D,
+        _error_callback: E,
+        _timeout: Option<Duration>,
+    ) -> Result<Self::Stream, BuildStreamError>
+    where
+        D: FnMut(&mut Data, &OutputCallbackInfo) + Send + 'static,
+        E: FnMut(StreamError) + Send + 'static,
+    {
+        if sample_format != SampleFormat::F32 || config.channels != CHANNELS || config.sample_rate.0 != RATE {
+            return Err(BuildStreamError::StreamConfigNotSupported);
+        }
+        let ring = ring();
+        let generation = GENERATION.fetch_add(1, Ordering::AcqRel) + 1;
+        let playing = Arc::new(AtomicBool::new(false));
+        let play = playing.clone();
+        std::thread::Builder::new()
+            .name("audio output".into())
+            .spawn(move || {
+                let start = Instant::now();
+                let mut chunk = vec![0.0f32; CHUNK_FRAMES * 2];
+                while GENERATION.load(Ordering::Acquire) == generation {
+                    let written = ring.written.load(Ordering::Relaxed);
+                    let read = ring.read.load(Ordering::Acquire);
+                    if !play.load(Ordering::Acquire) || written.wrapping_sub(read) >= AHEAD_FRAMES {
+                        std::thread::sleep(Duration::from_millis(4));
+                        continue;
+                    }
+                    let now = start.elapsed();
+                    let callback = StreamInstant::new(now.as_secs() as i64, now.subsec_nanos());
+                    let ahead = Duration::from_secs_f64(f64::from(written.wrapping_sub(read)) / f64::from(RATE));
+                    let later = now + ahead;
+                    let playback = StreamInstant::new(later.as_secs() as i64, later.subsec_nanos());
+                    let info = OutputCallbackInfo::new(OutputStreamTimestamp { callback, playback });
+                    // SAFETY: `chunk` holds `len` f32 samples and outlives `data`.
+                    let mut data = unsafe { Data::from_parts(chunk.as_mut_ptr().cast(), chunk.len(), SampleFormat::F32) };
+                    data_callback(&mut data, &info);
+                    let samples = ring.samples.as_ptr().cast_mut();
+                    for (i, frame) in chunk.chunks_exact(2).enumerate() {
+                        let at = (written as usize + i) % RING_FRAMES;
+                        // SAFETY: inside the ring; only this thread writes
+                        // samples, the worklet reads those before `written`.
+                        unsafe {
+                            *samples.add(at * 2) = frame[0];
+                            *samples.add(at * 2 + 1) = frame[1];
+                        }
+                    }
+                    ring.written.store(written.wrapping_add(CHUNK_FRAMES as u32), Ordering::Release);
+                }
+            })
+            .map_err(|_| BuildStreamError::DeviceNotAvailable)?;
+        Ok(Stream { playing, generation })
+    }
+}
+
+impl HostTrait for Host {
+    type Devices = Devices;
+    type Device = Device;
+
+    fn is_available() -> bool {
+        true
+    }
+
+    fn devices(&self) -> Result<Self::Devices, DevicesError> {
+        Devices::new()
+    }
+
+    fn default_input_device(&self) -> Option<Device> {
+        None
+    }
+
+    fn default_output_device(&self) -> Option<Device> {
+        Some(Device)
+    }
+}
+
+impl StreamTrait for Stream {
+    fn play(&self) -> Result<(), PlayStreamError> {
+        self.playing.store(true, Ordering::Release);
+        Ok(())
+    }
+
+    fn pause(&self) -> Result<(), PauseStreamError> {
+        self.playing.store(false, Ordering::Release);
+        Ok(())
+    }
+}
+
+impl Drop for Stream {
+    fn drop(&mut self) {
+        // Stops the thread unless a newer stream took the ring over.
+        let _ = GENERATION.compare_exchange(self.generation, self.generation + 1, Ordering::AcqRel, Ordering::Relaxed);
+    }
+}
+
+impl Iterator for Devices {
+    type Item = Device;
+
+    fn next(&mut self) -> Option<Device> {
+        (!std::mem::replace(&mut self.0, true)).then_some(Device)
+    }
+}
+
+impl Iterator for SupportedInputConfigs {
+    type Item = SupportedStreamConfigRange;
+
+    fn next(&mut self) -> Option<SupportedStreamConfigRange> {
+        None
+    }
+}
+
+impl Iterator for SupportedOutputConfigs {
+    type Item = SupportedStreamConfigRange;
+
+    fn next(&mut self) -> Option<SupportedStreamConfigRange> {
+        (!std::mem::replace(&mut self.0, true)).then(range)
+    }
+}
