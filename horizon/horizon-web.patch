+    fn request_adapter(
+        &self,
+        options: &wgpu::RequestAdapterOptions<'_, '_>,
+    ) -> Pin<Box<dyn RequestAdapterFuture>> {
+        let high = options.power_preference == wgpu::PowerPreference::HighPerformance;
+        // SAFETY: a plain value.
+        let id = unsafe { ffi::request_adapter(high) };
+        let result = if id == 0 {
+            Err(wgpu::RequestAdapterError::NotFound {
+                active_backends: wgpu::Backends::BROWSER_WEBGPU,
+                requested_backends: wgpu::Backends::BROWSER_WEBGPU,
+                supported_backends: wgpu::Backends::BROWSER_WEBGPU,
+                no_fallback_backends: wgpu::Backends::empty(),
+                no_adapter_backends: wgpu::Backends::BROWSER_WEBGPU,
+                incompatible_surface_backends: wgpu::Backends::empty(),
+            })
+        } else {
+            Ok(DispatchAdapter::custom(WebAdapter::new(handle(id))))
+        };
+        Box::pin(ready(result))
+    }
+
+    fn poll_all_devices(&self, force_wait: bool) -> bool {
+        poll_waiting(force_wait)
+    }
+
+    fn wgsl_language_features(&self) -> wgpu::WgslLanguageFeatures {
+        wgpu::WgslLanguageFeatures::empty()
+    }
+
+    fn enumerate_adapters(
+        &self,
+        _backends: wgpu::Backends,
+    ) -> Pin<Box<dyn EnumerateAdapterFuture>> {
+        // SAFETY: a plain value.
+        let id = unsafe { ffi::request_adapter(true) };
+        let adapters = if id == 0 {
+            Vec::new()
+        } else {
+            vec![DispatchAdapter::custom(WebAdapter::new(handle(id)))]
+        };
+        Box::pin(ready(adapters))
+    }
