+    fn poll(
+        &self,
+        poll_type: wgpu::wgt::PollType<u64>,
+    ) -> Result<wgpu::PollStatus, wgpu::PollError> {
+        let wait = poll_type.is_wait();
+        let empty = poll_waiting(wait);
+        self.report_errors();
+        Ok(if wait {
+            wgpu::PollStatus::WaitSucceeded
+        } else if empty {
+            wgpu::PollStatus::QueueEmpty
+        } else {
+            wgpu::PollStatus::Poll
+        })
+    }
