index 000000000..75c7bebf3
--- /dev/null
+++ b/third_party/winit/src/platform_impl/wasi/window.rs
@@ -0,0 +1,382 @@
+use std::collections::VecDeque;
+use std::sync::{Arc, Mutex};
+
+use crate::cursor::Cursor;
+use crate::dpi::{PhysicalPosition, PhysicalSize, Position, Size};
+use crate::platform_impl::Fullscreen;
+use crate::window::{CursorIcon, ImePurpose};
+use crate::{error, window};
+
+use super::event_loop::Windows;
+use super::{page, ActiveEventLoop, MonitorHandle, WindowId};
+
+/// CSS cursors by index (display.ts `CURSORS`).
+fn cursor_kind(icon: CursorIcon) -> i32 {
+    match icon {
+        CursorIcon::Text | CursorIcon::VerticalText => 1,
+        CursorIcon::Wait => 2,
+        CursorIcon::Crosshair | CursorIcon::Cell => 3,
+        CursorIcon::Progress => 4,
+        CursorIcon::NwseResize | CursorIcon::NwResize | CursorIcon::SeResize => 5,
+        CursorIcon::NeswResize | CursorIcon::NeResize | CursorIcon::SwResize => 6,
+        CursorIcon::EwResize | CursorIcon::EResize | CursorIcon::WResize | CursorIcon::ColResize => 7,
+        CursorIcon::NsResize | CursorIcon::NResize | CursorIcon::SResize | CursorIcon::RowResize => 8,
+        CursorIcon::Move | CursorIcon::AllScroll | CursorIcon::Grab | CursorIcon::Grabbing => 9,
+        CursorIcon::NotAllowed | CursorIcon::NoDrop => 10,
+        CursorIcon::Pointer => 11,
+        _ => 0,
+    }
+}
+
+/// `cursor_set`'s index for no cursor.
+const CURSOR_NONE: i32 = 12;
+
+struct State {
+    title: String,
+    visible: bool,
+    cursor: i32,
+    cursor_visible: bool,
+}
+
+pub struct Window {
+    id: WindowId,
+    windows: Arc<Mutex<Windows>>,
+    state: Mutex<State>,
+}
+
+impl Window {
+    pub(crate) fn new(
+        el: &ActiveEventLoop,
+        attrs: window::WindowAttributes,
+    ) -> Result<Self, error::OsError> {
+        let page = page();
+        let (w, h): (i32, i32) = match attrs.inner_size {
+            Some(size) => size.to_logical::<i32>(page.scale).into(),
+            None => page.css,
+        };
+        let id = {
+            let mut windows = el.windows.lock().unwrap();
+            windows.next += 1;
+            let id = WindowId(windows.next);
+            windows.live.push(id);
+            windows.created.push(id);
+            id
+        };
+        // SAFETY: plain values.
+        unsafe { super::window_create(id.0 as u32, w, h, attrs.visible) };
+        let window = Self {
+            id,
+            windows: el.windows.clone(),
+            state: Mutex::new(State {
+                title: String::new(),
+                visible: attrs.visible,
+                cursor: 0,
+                cursor_visible: true,
+            }),
+        };
+        window.set_title(&attrs.title);
+        Ok(window)
+    }
+
+    pub(crate) fn maybe_queue_on_main(&self, f: impl FnOnce(&Self) + Send + 'static) {
+        f(self)
+    }
+
+    pub(crate) fn maybe_wait_on_main<R: Send>(&self, f: impl FnOnce(&Self) -> R + Send) -> R {
+        f(self)
+    }
+
+    #[inline]
+    pub fn id(&self) -> WindowId {
+        self.id
+    }
+
+    #[inline]
+    pub fn primary_monitor(&self) -> Option<MonitorHandle> {
+        Some(MonitorHandle)
+    }
+
+    #[inline]
+    pub fn available_monitors(&self) -> VecDeque<MonitorHandle> {
+        VecDeque::from([MonitorHandle])
+    }
+
+    #[inline]
+    pub fn current_monitor(&self) -> Option<MonitorHandle> {
+        Some(MonitorHandle)
+    }
+
+    #[inline]
+    pub fn scale_factor(&self) -> f64 {
+        page().scale
+    }
+
+    #[inline]
+    pub fn request_redraw(&self) {
+        let mut windows = self.windows.lock().unwrap();
+        if !windows.redraws.contains(&self.id) {
+            windows.redraws.push_back(self.id);
+        }
+    }
+
+    #[inline]
+    pub fn pre_present_notify(&self) {}
+
+    #[inline]
+    pub fn reset_dead_keys(&self) {}
+
+    #[inline]
+    pub fn inner_position(&self) -> Result<PhysicalPosition<i32>, error::NotSupportedError> {
+        Ok((0, 0).into())
+    }
+
+    #[inline]
+    pub fn outer_position(&self) -> Result<PhysicalPosition<i32>, error::NotSupportedError> {
+        Ok((0, 0).into())
+    }
+
+    #[inline]
+    pub fn set_outer_position(&self, _position: Position) {}
+
+    #[inline]
+    pub fn inner_size(&self) -> PhysicalSize<u32> {
+        page().pixels.into()
+    }
+
+    /// The page sizes the canvas.
+    #[inline]
+    pub fn request_inner_size(&self, _size: Size) -> Option<PhysicalSize<u32>> {
+        None
+    }
+
+    #[inline]
+    pub fn outer_size(&self) -> PhysicalSize<u32> {
+        self.inner_size()
+    }
+
+    #[inline]
+    pub fn set_min_inner_size(&self, _: Option<Size>) {}
+
+    #[inline]
+    pub fn set_max_inner_size(&self, _: Option<Size>) {}
+
+    #[inline]
+    pub fn title(&self) -> String {
+        self.state.lock().unwrap().title.clone()
+    }
+
+    #[inline]
+    pub fn set_title(&self, title: &str) {
+        self.state.lock().unwrap().title = title.to_owned();
+        // SAFETY: the bytes of a live string.
+        unsafe { super::window_title(self.id.0 as u32, title.as_ptr(), title.len()) };
+    }
+
+    #[inline]
+    pub fn set_transparent(&self, _transparent: bool) {}
+
+    #[inline]
+    pub fn set_blur(&self, _blur: bool) {}
+
+    #[inline]
+    pub fn set_visible(&self, visible: bool) {
+        self.state.lock().unwrap().visible = visible;
+        // SAFETY: plain values.
+        unsafe { super::window_show(self.id.0 as u32, visible) };
+    }
+
+    #[inline]
+    pub fn is_visible(&self) -> Option<bool> {
+        Some(self.state.lock().unwrap().visible)
+    }
+
+    #[inline]
+    pub fn resize_increments(&self) -> Option<PhysicalSize<u32>> {
+        None
+    }
+
+    #[inline]
+    pub fn set_resize_increments(&self, _increments: Option<Size>) {}
+
+    #[inline]
+    pub fn set_resizable(&self, _resizeable: bool) {}
+
+    #[inline]
+    pub fn is_resizable(&self) -> bool {
+        true
+    }
+
+    #[inline]
+    pub fn set_minimized(&self, _minimized: bool) {}
+
+    #[inline]
+    pub fn is_minimized(&self) -> Option<bool> {
+        Some(false)
+    }
+
+    #[inline]
+    pub fn set_maximized(&self, _maximized: bool) {}
+
+    #[inline]
+    pub fn is_maximized(&self) -> bool {
+        true
+    }
+
+    #[inline]
+    pub(crate) fn set_fullscreen(&self, _monitor: Option<Fullscreen>) {}
+
+    #[inline]
+    pub(crate) fn fullscreen(&self) -> Option<Fullscreen> {
+        None
+    }
+
+    #[inline]
+    pub fn set_decorations(&self, _decorations: bool) {}
+
+    #[inline]
+    pub fn is_decorated(&self) -> bool {
+        false
+    }
+
+    #[inline]
+    pub fn set_window_level(&self, _level: window::WindowLevel) {}
+
+    #[inline]
+    pub fn set_window_icon(&self, _window_icon: Option<crate::icon::Icon>) {}
+
+    #[inline]
+    pub fn set_ime_cursor_area(&self, _position: Position, _size: Size) {}
+
+    #[inline]
+    pub fn set_ime_allowed(&self, _allowed: bool) {}
+
+    #[inline]
+    pub fn set_ime_purpose(&self, _purpose: ImePurpose) {}
+
+    #[inline]
+    pub fn focus_window(&self) {}
+
+    #[inline]
+    pub fn request_user_attention(&self, _request_type: Option<window::UserAttentionType>) {}
+
+    #[inline]
+    pub fn set_cursor(&self, cursor: Cursor) {
+        let mut state = self.state.lock().unwrap();
+        state.cursor = match cursor {
+            Cursor::Icon(icon) => cursor_kind(icon),
+            Cursor::Custom(_) => 0,
+        };
+        if state.cursor_visible {
+            // SAFETY: a plain value.
+            unsafe { super::cursor_set(state.cursor) };
+        }
+    }
+
+    #[inline]
+    pub fn set_cursor_position(&self, _: Position) -> Result<(), error::ExternalError> {
+        Err(error::ExternalError::NotSupported(error::NotSupportedError::new()))
+    }
+
+    /// Locked and confined both lock the pointer: the page can't confine it.
+    #[inline]
+    pub fn set_cursor_grab(
+        &self,
+        mode: window::CursorGrabMode,
+    ) -> Result<(), error::ExternalError> {
+        let lock = !matches!(mode, window::CursorGrabMode::None);
+        // SAFETY: a plain value.
+        unsafe { super::mouse_relative(lock) };
+        Ok(())
+    }
+
+    #[inline]
