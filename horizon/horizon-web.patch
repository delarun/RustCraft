+/// An error from the browser's WebGPU.
+#[derive(Debug)]
+struct WebError(String);
+
+impl fmt::Display for WebError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str(&self.0)
+    }
+}
+
+impl std::error::Error for WebError {}
+
+fn validation(message: String) -> wgpu::Error {
+    wgpu::Error::Validation {
+        source: Box::new(WebError(message.clone())),
+        description: message,
+    }
+}
+
+impl WebDevice {
+    /// Hands the errors raised outside a scope to the game's handler (or the log).
+    fn report_errors(&self) {
+        // SAFETY: the host writes at most `cap` bytes.
+        while let Some(message) =
+            host_error(|out, cap| unsafe { ffi::take_error(self.h.0, out, cap) })
+        {
+            let handler = self.errors.0.borrow().clone();
+            match handler {
+                Some(handler) => handler(validation(message)),
+                None => log::error!("WebGPU: {message}"),
+            }
+        }
+    }
+}
