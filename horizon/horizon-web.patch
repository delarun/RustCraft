+const MAP_READ: u32 = 1;
+const MAP_WRITE: u32 = 2;
+
+// `map_mode`: how the buffer is mapped now (0 not mapped).
+object!(WebBuffer { map_mode: Rc<Cell<u32>> });
+
+impl BufferInterface for WebBuffer {
+    fn map_async(
+        &self,
+        mode: wgpu::MapMode,
+        range: Range<wgpu::BufferAddress>,
+        callback: BufferMapCallback,
+    ) {
+        let mode = match mode {
+            wgpu::MapMode::Read => MAP_READ,
+            wgpu::MapMode::Write => MAP_WRITE,
+        };
+        // SAFETY: plain values.
+        let ticket = unsafe {
+            ffi::map(
+                self.h.0,
+                mode,
+                range.start as f64,
+                (range.end - range.start) as f64,
+            )
+        };
+        WAITING.with_borrow_mut(|w| {
+            w.push(Waiting::Map {
+                ticket,
+                buffer: self.clone(),
+                mode,
+                callback,
+            })
+        });
+    }
+
+    fn get_mapped_range(
+        &self,
+        sub_range: Range<wgpu::BufferAddress>,
+    ) -> Result<DispatchBufferMappedRange, wgpu::MapRangeError> {
+        let len = (sub_range.end - sub_range.start) as usize;
+        let mut data = vec![0u8; len];
+        let write = self.map_mode.get() == MAP_WRITE;
+        if !write {
+            // SAFETY: the host writes `len` bytes into a buffer that long.
+            unsafe { ffi::mapped_read(self.h.0, sub_range.start as f64, data.as_mut_ptr(), len) };
+        }
+        Ok(DispatchBufferMappedRange::custom(WebMappedRange {
+            buffer: self.h.clone(),
+            offset: sub_range.start,
+            data,
+            write,
+        }))
+    }
+
+    fn unmap(&self) {
+        self.map_mode.set(0);
+        // SAFETY: a plain value.
+        unsafe { ffi::unmap(self.h.0) };
+    }
+
+    fn destroy(&self) {
+        // SAFETY: a plain value.
+        unsafe { ffi::destroy(self.h.0) };
+    }
+}
+
+/// A mapped range: a copy here; written back when dropped if mapped to write.
+#[derive(Debug)]
+struct WebMappedRange {
+    buffer: H,
+    offset: u64,
+    data: Vec<u8>,
+    write: bool,
+}
+
+impl BufferMappedRangeInterface for WebMappedRange {
+    fn len(&self) -> usize {
+        self.data.len()
+    }
+
+    unsafe fn read_slice(&self) -> &[u8] {
+        &self.data
+    }
+
+    unsafe fn write_slice(&mut self) -> wgpu::WriteOnly<'_, [u8]> {
+        wgpu::WriteOnly::from(&mut self.data[..])
+    }
+}
+
+impl Drop for WebMappedRange {
+    fn drop(&mut self) {
+        if self.write {
+            // SAFETY: the bytes of a live vector.
+            unsafe {
+                ffi::mapped_write(
+                    self.buffer.0,
+                    self.offset as f64,
+                    self.data.as_ptr(),
+                    self.data.len(),
+                )
+            };
+        }
+    }
+}
