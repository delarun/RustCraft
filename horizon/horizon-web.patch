+object!(WebQueue { device: WebDevice, submissions: Rc<Cell<u64>> });
+
+impl QueueInterface for WebQueue {
+    fn write_buffer(&self, buffer: &DispatchBuffer, offset: wgpu::BufferAddress, data: &[u8]) {
+        let buffer = id_of!(buffer, WebBuffer);
+        // SAFETY: the bytes of a live slice.
+        unsafe { ffi::write_buffer(self.h.0, buffer, offset as f64, data.as_ptr(), data.len()) };
+    }
+
+    fn create_staging_buffer(&self, size: wgpu::BufferSize) -> Option<DispatchQueueWriteBuffer> {
+        Some(DispatchQueueWriteBuffer::custom(WebStaging(
+            vec![0; size.get() as usize],
+        )))
+    }
+
+    fn validate_write_buffer(
+        &self,
+        _buffer: &DispatchBuffer,
+        _offset: wgpu::BufferAddress,
+        _size: wgpu::BufferSize,
+    ) -> Option<()> {
+        Some(())
+    }
+
+    fn write_staging_buffer(
+        &self,
+        buffer: &DispatchBuffer,
+        offset: wgpu::BufferAddress,
+        staging_buffer: &DispatchQueueWriteBuffer,
+    ) {
+        let staging = staging_buffer
+            .as_custom::<WebStaging>()
+            .expect("not a web staging buffer");
+        self.write_buffer(buffer, offset, &staging.0);
+    }
+
+    fn write_texture(
+        &self,
+        texture: wgpu::TexelCopyTextureInfo<'_>,
+        data: &[u8],
+        data_layout: wgpu::TexelCopyBufferLayout,
+        size: wgpu::Extent3d,
+    ) {
+        let json = json!({
+            "destination": texture_copy(&texture),
+            "layout": buffer_layout(&data_layout),
+            "size": extent(size),
+        })
+        .to_string();
+        // SAFETY: the bytes of a live string and slice.
+        unsafe {
+            ffi::write_texture(
+                self.h.0,
+                json.as_ptr(),
+                json.len(),
+                data.as_ptr(),
+                data.len(),
+            )
+        };
+    }
+
+    fn submit(&self, command_buffers: &mut dyn Iterator<Item = DispatchCommandBuffer>) -> u64 {
+        // Held until submitted: dropping one forgets it.
+        let buffers: Vec<DispatchCommandBuffer> = command_buffers.collect();
+        let ids: Vec<u32> = buffers
+            .iter()
+            .map(|b| id_of!(b, WebCommandBuffer))
+            .collect();
+        // SAFETY: the words of a live vector.
+        unsafe { ffi::submit(self.h.0, ids.as_ptr(), ids.len()) };
+        drop(buffers);
+        poll_waiting(false);
+        self.device.report_errors();
+        let index = self.submissions.get() + 1;
+        self.submissions.set(index);
+        index
+    }
+
+    fn get_timestamp_period(&self) -> f32 {
+        1.0
+    }
+
+    fn on_submitted_work_done(&self, callback: BoxSubmittedWorkDoneCallback) {
+        // SAFETY: a plain value.
+        let ticket = unsafe { ffi::work_done(self.h.0) };
+        WAITING.with_borrow_mut(|w| w.push(Waiting::Work { ticket, callback }));
+    }
+
+    fn compact_blas(&self, _blas: &DispatchBlas) -> (Option<u64>, DispatchBlas) {
+        panic!("WebGPU has no ray tracing")
+    }
+
+    fn present(&self, detail: &DispatchSurfaceOutputDetail) {
+        let detail = detail
+            .as_custom::<WebSurfaceOutput>()
+            .expect("not a web frame");
+        // SAFETY: a plain value.
+        unsafe { ffi::surface_present(detail.surface.0) };
+    }
+}
