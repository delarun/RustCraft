+    fn push_error_scope(&self, filter: wgpu::ErrorFilter) -> u32 {
+        let filter = match filter {
+            wgpu::ErrorFilter::Validation => 0,
+            wgpu::ErrorFilter::OutOfMemory => 1,
+            wgpu::ErrorFilter::Internal => 2,
+        };
+        // SAFETY: plain values.
+        unsafe { ffi::push_error_scope(self.h.0, filter) };
+        let depth = self.scopes.get();
+        self.scopes.set(depth + 1);
+        depth
+    }
+
+    fn pop_error_scope(&self, _index: u32) -> Pin<Box<dyn PopErrorScopeFuture>> {
+        self.scopes.set(self.scopes.get().saturating_sub(1));
+        // SAFETY: the host writes at most `cap` bytes.
+        let error = host_error(|out, cap| unsafe { ffi::pop_error_scope(self.h.0, out, cap) });
+        Box::pin(ready(error.map(validation)))
+    }
