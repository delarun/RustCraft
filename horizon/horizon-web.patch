+    fn create_shader_module(
+        &self,
+        desc: wgpu::ShaderModuleDescriptor<'_>,
+        _shader_bound_checks: wgpu::ShaderRuntimeChecks,
+    ) -> DispatchShaderModule {
+        // naga's WGSL, which wgpu reads elsewhere, is laxer than the browser's:
+        // written again by naga, every operation has its parentheses.
+        let code = match desc.source {
+            wgpu::ShaderSource::Wgsl(code) => naga::front::wgsl::parse_str(&code)
+                .map_err(|e| e.emit_to_string(&code))
+                .and_then(|module| naga_to_wgsl(&module))
+                .unwrap_or_else(|e| {
+                    log::warn!("WebGPU: shader {:?} kept as written: {e}", desc.label);
+                    code.into_owned()
+                }),
+            wgpu::ShaderSource::Naga(module) => naga_to_wgsl(&module).unwrap_or_else(|e| {
+                log::error!("WebGPU: shader {:?} to WGSL: {e}", desc.label);
+                String::new()
+            }),
+            _ => panic!("WebGPU takes WGSL shaders"),
+        };
+        // naga doesn't check that derivatives are taken in uniform control flow.
+        let code = format!("diagnostic(off, derivative_uniformity);\n{code}");
+        let id = create(
+            self.h.0,
+            Kind::ShaderModule,
+            &json!({ "label": desc.label, "code": code }),
+        );
+        DispatchShaderModule::custom(WebShaderModule { h: handle(id) })
+    }
+
+    unsafe fn create_shader_module_passthrough(
+        &self,
+        _desc: &wgpu::ShaderModuleDescriptorPassthrough<'_>,
+    ) -> DispatchShaderModule {
+        panic!("WebGPU takes WGSL shaders")
+    }
+
+    fn create_bind_group_layout(
+        &self,
+        desc: &wgpu::BindGroupLayoutDescriptor<'_>,
+    ) -> DispatchBindGroupLayout {
+        let entries: Vec<Value> = desc.entries.iter().map(bind_group_layout_entry).collect();
+        let id = create(
+            self.h.0,
+            Kind::BindGroupLayout,
+            &json!({ "label": desc.label, "entries": entries }),
+        );
+        DispatchBindGroupLayout::custom(WebBindGroupLayout { h: handle(id) })
+    }
+
+    fn create_bind_group(&self, desc: &wgpu::BindGroupDescriptor<'_>) -> DispatchBindGroup {
+        let entries: Vec<Value> = desc
+            .entries
+            .iter()
+            .map(|entry| {
+                let resource = match &entry.resource {
+                    wgpu::BindingResource::Buffer(binding) => json!({
+                        "buffer": id_of!(binding.buffer, WebBuffer),
+                        "offset": binding.offset,
+                        "size": binding.size.map(|s| s.get()),
+                    }),
+                    wgpu::BindingResource::Sampler(sampler) => {
+                        json!({ "sampler": id_of!(sampler, WebSampler) })
+                    }
+                    wgpu::BindingResource::TextureView(view) => {
+                        json!({ "view": id_of!(view, WebTextureView) })
+                    }
+                    other => panic!("WebGPU has no binding {other:?}"),
+                };
+                json!({ "binding": entry.binding, "resource": resource })
+            })
+            .collect();
+        let layout = id_of!(desc.layout, WebBindGroupLayout);
+        let id = create(
+            self.h.0,
+            Kind::BindGroup,
+            &json!({ "label": desc.label, "layout": layout, "entries": entries }),
+        );
+        DispatchBindGroup::custom(WebBindGroup { h: handle(id) })
+    }
