+impl SurfaceInterface for WebSurface {
+    fn get_capabilities(&self, _adapter: &DispatchAdapter) -> wgpu::SurfaceCapabilities {
+        // SAFETY: the host writes at most `cap` bytes.
+        let preferred = host_string(|out, cap| unsafe { ffi::preferred_format(out, cap) });
+        let preferred = if preferred == "rgba8unorm" {
+            wgpu::TextureFormat::Rgba8Unorm
+        } else {
+            wgpu::TextureFormat::Bgra8Unorm
+        };
+        let other = if preferred == wgpu::TextureFormat::Rgba8Unorm {
+            wgpu::TextureFormat::Bgra8Unorm
+        } else {
+            wgpu::TextureFormat::Rgba8Unorm
+        };
+        let formats = vec![preferred, other, wgpu::TextureFormat::Rgba16Float];
+        wgpu::SurfaceCapabilities {
+            format_capabilities: formats
+                .iter()
+                .map(|&format| wgpu::SurfaceFormatCapabilities {
+                    format,
+                    color_spaces: wgpu::SurfaceColorSpaces::SRGB,
+                })
+                .collect(),
+            formats,
+            present_modes: vec![wgpu::PresentMode::Fifo],
+            alpha_modes: vec![
+                wgpu::CompositeAlphaMode::Opaque,
+                wgpu::CompositeAlphaMode::PreMultiplied,
+            ],
+            usages: wgpu::TextureUsages::RENDER_ATTACHMENT
+                | wgpu::TextureUsages::COPY_SRC
+                | wgpu::TextureUsages::COPY_DST
+                | wgpu::TextureUsages::TEXTURE_BINDING,
+        }
+    }
+
+    fn configure(&self, device: &DispatchDevice, config: &wgpu::SurfaceConfiguration) {
+        let device = device.as_custom::<WebDevice>().expect("not a web device");
+        let json = json!({
+            "format": texture_format(config.format),
+            "usage": config.usage.bits() & 0x1f,
+            "alphaMode": match config.alpha_mode {
+                wgpu::CompositeAlphaMode::PreMultiplied => "premultiplied",
+                _ => "opaque",
+            },
+            "viewFormats": config.view_formats.iter().map(|&f| texture_format(f)).collect::<Vec<_>>(),
+            "width": config.width,
+            "height": config.height,
+        })
+        .to_string();
+        // SAFETY: the bytes of a live string.
+        unsafe { ffi::surface_configure(self.h.0, device.h.0, json.as_ptr(), json.len()) };
+        *self.configured.borrow_mut() = Some(config.clone());
+    }
+
+    fn get_current_texture(
+        &self,
+    ) -> (
+        Option<DispatchTexture>,
+        wgpu::SurfaceStatus,
+        DispatchSurfaceOutputDetail,
+    ) {
+        let detail = DispatchSurfaceOutputDetail::custom(WebSurfaceOutput {
+            surface: self.h.clone(),
+        });
+        if self.configured.borrow().is_none() {
+            return (None, wgpu::SurfaceStatus::Outdated, detail);
+        }
+        // SAFETY: a plain value.
+        let id = unsafe { ffi::surface_texture(self.h.0) };
+        if id == 0 {
+            return (None, wgpu::SurfaceStatus::Timeout, detail);
+        }
+        (
+            Some(DispatchTexture::custom(WebTexture { h: handle(id) })),
+            wgpu::SurfaceStatus::Good,
+            detail,
+        )
+    }
+}
+
+// --- encoding -------------------------------------------------------------------
+
+object!(WebCommandEncoder {});
+
+fn encode(encoder: u32, op: Value) {
+    let json = op.to_string();
+    // SAFETY: the bytes of a live string.
+    unsafe { ffi::encode(encoder, json.as_ptr(), json.len()) };
+}
+
+impl CommandEncoderInterface for WebCommandEncoder {
+    fn copy_buffer_to_buffer(
+        &self,
+        source: &DispatchBuffer,
+        source_offset: wgpu::BufferAddress,
+        destination: &DispatchBuffer,
+        destination_offset: wgpu::BufferAddress,
+        copy_size: Option<wgpu::BufferAddress>,
+    ) {
+        encode(
+            self.h.0,
+            json!({
+                "op": "copyBufferToBuffer",
+                "source": id_of!(source, WebBuffer),
+                "sourceOffset": source_offset,
+                "destination": id_of!(destination, WebBuffer),
+                "destinationOffset": destination_offset,
+                "size": copy_size,
+            }),
+        );
+    }
+
+    fn copy_buffer_to_texture(
+        &self,
+        source: wgpu::TexelCopyBufferInfo<'_>,
+        destination: wgpu::TexelCopyTextureInfo<'_>,
+        copy_size: wgpu::Extent3d,
+    ) {
+        encode(
+            self.h.0,
+            json!({
+                "op": "copyBufferToTexture",
+                "source": buffer_copy(&source),
+                "destination": texture_copy(&destination),
+                "size": extent(copy_size),
+            }),
+        );
+    }
+
+    fn copy_texture_to_buffer(
+        &self,
+        source: wgpu::TexelCopyTextureInfo<'_>,
+        destination: wgpu::TexelCopyBufferInfo<'_>,
+        copy_size: wgpu::Extent3d,
+    ) {
+        encode(
+            self.h.0,
+            json!({
+                "op": "copyTextureToBuffer",
+                "source": texture_copy(&source),
+                "destination": buffer_copy(&destination),
+                "size": extent(copy_size),
+            }),
+        );
+    }
+
+    fn copy_texture_to_texture(
+        &self,
+        source: wgpu::TexelCopyTextureInfo<'_>,
+        destination: wgpu::TexelCopyTextureInfo<'_>,
+        copy_size: wgpu::Extent3d,
+    ) {
+        encode(
+            self.h.0,
+            json!({
+                "op": "copyTextureToTexture",
+                "source": texture_copy(&source),
+                "destination": texture_copy(&destination),
+                "size": extent(copy_size),
+            }),
+        );
+    }
+
+    fn begin_compute_pass(&self, desc: &wgpu::ComputePassDescriptor<'_>) -> DispatchComputePass {
+        DispatchComputePass::custom(WebComputePass {
+            encoder: self.h.clone(),
+            desc: json!({ "label": desc.label }),
+            ops: Ops::default(),
+        })
+    }
+
+    fn begin_render_pass(&self, desc: &wgpu::RenderPassDescriptor<'_>) -> DispatchRenderPass {
+        let mut ops = Ops::default();
+        let colors: Vec<Value> = desc
+            .color_attachments
+            .iter()
+            .map(|a| {
+                let Some(a) = a else { return Value::Null };
+                let view = a
+                    .view
+                    .as_custom::<WebTextureView>()
+                    .expect("not a web view");
+                ops.keep(view.h.clone());
+                let mut attachment = json!({
+                    "view": view.h.0,
+                    "storeOp": store_op(a.ops.store),
+                });
+                match a.ops.load {
+                    wgpu::LoadOp::Clear(c) => {
+                        attachment["loadOp"] = json!("clear");
+                        attachment["clearValue"] = json!([c.r, c.g, c.b, c.a]);
+                    }
+                    _ => attachment["loadOp"] = json!("load"),
+                }
+                if let Some(target) = a.resolve_target {
+                    let target = target
+                        .as_custom::<WebTextureView>()
+                        .expect("not a web view");
+                    ops.keep(target.h.clone());
+                    attachment["resolveTarget"] = json!(target.h.0);
+                }
+                if let Some(slice) = a.depth_slice {
+                    attachment["depthSlice"] = json!(slice);
+                }
+                attachment
+            })
+            .collect();
+        let mut pass = json!({ "label": desc.label, "colorAttachments": colors });
+        if let Some(ds) = &desc.depth_stencil_attachment {
+            let view = ds
+                .view
+                .as_custom::<WebTextureView>()
+                .expect("not a web view");
+            ops.keep(view.h.clone());
+            let mut attachment = json!({ "view": view.h.0 });
+            match &ds.depth_ops {
+                Some(depth) => {
+                    match depth.load {
+                        wgpu::LoadOp::Clear(v) => {
+                            attachment["depthLoadOp"] = json!("clear");
+                            attachment["depthClearValue"] = json!(v);
+                        }
+                        _ => attachment["depthLoadOp"] = json!("load"),
+                    }
+                    attachment["depthStoreOp"] = json!(store_op(depth.store));
+                }
+                None => attachment["depthReadOnly"] = json!(true),
+            }
+            match &ds.stencil_ops {
+                Some(stencil) => {
+                    match stencil.load {
+                        wgpu::LoadOp::Clear(v) => {
+                            attachment["stencilLoadOp"] = json!("clear");
+                            attachment["stencilClearValue"] = json!(v);
+                        }
+                        _ => attachment["stencilLoadOp"] = json!("load"),
+                    }
+                    attachment["stencilStoreOp"] = json!(store_op(stencil.store));
+                }
+                None => attachment["stencilReadOnly"] = json!(true),
+            }
+            pass["depthStencilAttachment"] = attachment;
+        }
+        if let Some(set) = desc.occlusion_query_set {
+            let set = set.as_custom::<WebQuerySet>().expect("not a web query set");
+            ops.keep(set.h.clone());
+            pass["occlusionQuerySet"] = json!(set.h.0);
+        }
+        if let Some(writes) = &desc.timestamp_writes {
+            let set = writes
+                .query_set
+                .as_custom::<WebQuerySet>()
+                .expect("not a web query set");
+            ops.keep(set.h.clone());
+            pass["timestampWrites"] = json!({
+                "querySet": set.h.0,
+                "beginningOfPassWriteIndex": writes.beginning_of_pass_write_index,
+                "endOfPassWriteIndex": writes.end_of_pass_write_index,
+            });
+        }
+        DispatchRenderPass::custom(WebRenderPass {
+            encoder: self.h.clone(),
+            desc: pass,
+            ops,
+        })
+    }
+
+    fn finish(&mut self) -> DispatchCommandBuffer {
+        // SAFETY: a plain value.
+        let id = unsafe { ffi::finish(self.h.0) };
+        DispatchCommandBuffer::custom(WebCommandBuffer { h: handle(id) })
+    }
+
+    fn clear_texture(&self, texture: &DispatchTexture, range: &wgpu::ImageSubresourceRange) {
+        encode(
+            self.h.0,
+            json!({
+                "op": "clearTexture",
+                "texture": id_of!(texture, WebTexture),
+                "aspect": texture_aspect(range.aspect),
+                "baseMipLevel": range.base_mip_level,
+                "mipLevelCount": range.mip_level_count,
+                "baseArrayLayer": range.base_array_layer,
+                "arrayLayerCount": range.array_layer_count,
+            }),
+        );
+    }
+
+    fn clear_buffer(
+        &self,
+        buffer: &DispatchBuffer,
+        offset: wgpu::BufferAddress,
+        size: Option<wgpu::BufferAddress>,
+    ) {
+        encode(
+            self.h.0,
+            json!({ "op": "clearBuffer", "buffer": id_of!(buffer, WebBuffer), "offset": offset, "size": size }),
+        );
+    }
+
+    fn insert_debug_marker(&self, _label: &str) {}
+    fn push_debug_group(&self, _label: &str) {}
+    fn pop_debug_group(&self) {}
+
+    fn write_timestamp(&self, _query_set: &DispatchQuerySet, _query_index: u32) {}
+
+    fn resolve_query_set(
+        &self,
+        query_set: &DispatchQuerySet,
+        first_query: u32,
+        query_count: u32,
+        destination: &DispatchBuffer,
+        destination_offset: wgpu::BufferAddress,
+    ) {
+        encode(
+            self.h.0,
+            json!({
+                "op": "resolveQuerySet",
+                "querySet": id_of!(query_set, WebQuerySet),
+                "firstQuery": first_query,
+                "queryCount": query_count,
+                "destination": id_of!(destination, WebBuffer),
+                "destinationOffset": destination_offset,
+            }),
+        );
+    }
+
+    fn mark_acceleration_structures_built<'a>(
+        &self,
+        _blas: &mut dyn Iterator<Item = &'a wgpu::Blas>,
+        _tlas: &mut dyn Iterator<Item = &'a wgpu::Tlas>,
+    ) {
+    }
+
+    fn build_acceleration_structures<'a>(
+        &self,
+        _blas: &mut dyn Iterator<Item = &'a wgpu::BlasBuildEntry<'a>>,
+        _tlas: &mut dyn Iterator<Item = &'a wgpu::Tlas>,
+    ) {
+        panic!("WebGPU has no ray tracing")
+    }
+
+    fn transition_resources<'a>(
+        &mut self,
+        _buffer_transitions: &mut dyn Iterator<
+            Item = wgpu::wgt::BufferTransition<&'a DispatchBuffer>,
+        >,
+        _texture_transitions: &mut dyn Iterator<
+            Item = wgpu::wgt::TextureTransition<&'a DispatchTexture>,
+        >,
+    ) {
+    }
+}
