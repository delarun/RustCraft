+// --- callbacks that wait on the host ------------------------------------------
+
+enum Waiting {
+    Map {
+        ticket: u32,
+        buffer: WebBuffer,
+        mode: u32,
+        callback: BufferMapCallback,
+    },
+    Work {
+        ticket: u32,
+        callback: BoxSubmittedWorkDoneCallback,
+    },
+}
+
+thread_local! {
+    static WAITING: RefCell<Vec<Waiting>> = const { RefCell::new(Vec::new()) };
+}
+
+/// Calls the callbacks whose wait is over (all of them when `wait`); true if
+/// none is left.
+fn poll_waiting(wait: bool) -> bool {
+    loop {
+        let settled = WAITING.with_borrow_mut(|waiting| {
+            let index = waiting.iter().position(|w| {
+                let ticket = match w {
+                    Waiting::Map { ticket, .. } | Waiting::Work { ticket, .. } => *ticket,
+                };
+                // SAFETY: plain values.
+                let state = unsafe {
+                    if wait {
+                        ffi::ticket_wait(ticket)
+                    } else {
+                        ffi::ticket_state(ticket)
+                    }
+                };
+                if state != 0 {
+                    TICKET_RESULT.set(state);
+                }
+                state != 0
+            })?;
+            Some((waiting.remove(index), TICKET_RESULT.get()))
+        });
+        let Some((settled, state)) = settled else {
+            return WAITING.with_borrow(Vec::is_empty);
+        };
+        match settled {
+            Waiting::Map {
+                buffer,
+                mode,
+                callback,
+                ..
+            } => {
+                if state == 1 {
+                    buffer.map_mode.set(mode);
+                    callback(Ok(()));
+                } else {
+                    callback(Err(wgpu::BufferAsyncError));
+                }
+            }
+            Waiting::Work { callback, .. } => callback(),
+        }
+    }
+}
+
+thread_local! {
+    static TICKET_RESULT: Cell<u32> = const { Cell::new(0) };
+}
