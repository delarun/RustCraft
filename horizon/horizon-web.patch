@@ -0,0 +1,563 @@
+use std::cell::Cell;
+use std::collections::VecDeque;
+use std::marker::PhantomData;
+use std::sync::{mpsc, Arc, Mutex};
+use std::time::{Duration, Instant};
+
+use smol_str::SmolStr;
+
+use crate::error::EventLoopError;
+use crate::event::{self, InnerSizeWriter, Modifiers, StartCause};
+use crate::event_loop::{self, ControlFlow, DeviceEvents};
+use crate::keyboard::{
+    Key, KeyCode, KeyLocation, ModifiersKeys, ModifiersState, NamedKey, NativeKey, NativeKeyCode,
+    PhysicalKey,
+};
+use crate::window::{CustomCursor as RootCustomCursor, CustomCursorSource, Theme, WindowId as RootWindowId};
+
+use super::{page, DeviceId, KeyEventExtra, MonitorHandle, PlatformSpecificEventLoopAttributes, WindowId};
+
+/// How long a waiting loop sleeps between looks at the page's input.
+const POLL: Duration = Duration::from_millis(2);
+
+/// A key's code, logical name and location from its USB HID usage (SDL's
+/// scancodes; display.ts `SCANCODES`).
+fn convert_scancode(scancode: u32) -> (PhysicalKey, Option<NamedKey>, KeyLocation) {
+    use KeyLocation::{Left, Numpad, Right, Standard};
+    let letters = [
+        KeyCode::KeyA, KeyCode::KeyB, KeyCode::KeyC, KeyCode::KeyD, KeyCode::KeyE, KeyCode::KeyF,
+        KeyCode::KeyG, KeyCode::KeyH, KeyCode::KeyI, KeyCode::KeyJ, KeyCode::KeyK, KeyCode::KeyL,
+        KeyCode::KeyM, KeyCode::KeyN, KeyCode::KeyO, KeyCode::KeyP, KeyCode::KeyQ, KeyCode::KeyR,
+        KeyCode::KeyS, KeyCode::KeyT, KeyCode::KeyU, KeyCode::KeyV, KeyCode::KeyW, KeyCode::KeyX,
+        KeyCode::KeyY, KeyCode::KeyZ,
+    ];
+    let digits = [
+        KeyCode::Digit1, KeyCode::Digit2, KeyCode::Digit3, KeyCode::Digit4, KeyCode::Digit5,
+        KeyCode::Digit6, KeyCode::Digit7, KeyCode::Digit8, KeyCode::Digit9, KeyCode::Digit0,
+    ];
+    let functions = [
+        (KeyCode::F1, NamedKey::F1), (KeyCode::F2, NamedKey::F2), (KeyCode::F3, NamedKey::F3),
+        (KeyCode::F4, NamedKey::F4), (KeyCode::F5, NamedKey::F5), (KeyCode::F6, NamedKey::F6),
+        (KeyCode::F7, NamedKey::F7), (KeyCode::F8, NamedKey::F8), (KeyCode::F9, NamedKey::F9),
+        (KeyCode::F10, NamedKey::F10), (KeyCode::F11, NamedKey::F11), (KeyCode::F12, NamedKey::F12),
+    ];
+    let numpad_digits = [
+        KeyCode::Numpad1, KeyCode::Numpad2, KeyCode::Numpad3, KeyCode::Numpad4, KeyCode::Numpad5,
+        KeyCode::Numpad6, KeyCode::Numpad7, KeyCode::Numpad8, KeyCode::Numpad9, KeyCode::Numpad0,
+    ];
+    let (code, named, location) = match scancode {
+        4..=29 => (letters[scancode as usize - 4], None, Standard),
+        30..=39 => (digits[scancode as usize - 30], None, Standard),
+        40 => (KeyCode::Enter, Some(NamedKey::Enter), Standard),
+        41 => (KeyCode::Escape, Some(NamedKey::Escape), Standard),
+        42 => (KeyCode::Backspace, Some(NamedKey::Backspace), Standard),
+        43 => (KeyCode::Tab, Some(NamedKey::Tab), Standard),
+        44 => (KeyCode::Space, Some(NamedKey::Space), Standard),
+        45 => (KeyCode::Minus, None, Standard),
+        46 => (KeyCode::Equal, None, Standard),
+        47 => (KeyCode::BracketLeft, None, Standard),
+        48 => (KeyCode::BracketRight, None, Standard),
+        49 => (KeyCode::Backslash, None, Standard),
+        51 => (KeyCode::Semicolon, None, Standard),
+        52 => (KeyCode::Quote, None, Standard),
+        53 => (KeyCode::Backquote, None, Standard),
+        54 => (KeyCode::Comma, None, Standard),
+        55 => (KeyCode::Period, None, Standard),
+        56 => (KeyCode::Slash, None, Standard),
+        57 => (KeyCode::CapsLock, Some(NamedKey::CapsLock), Standard),
+        58..=69 => {
+            let (code, named) = functions[scancode as usize - 58];
+            (code, Some(named), Standard)
+        },
+        70 => (KeyCode::PrintScreen, Some(NamedKey::PrintScreen), Standard),
+        71 => (KeyCode::ScrollLock, Some(NamedKey::ScrollLock), Standard),
+        72 => (KeyCode::Pause, Some(NamedKey::Pause), Standard),
+        73 => (KeyCode::Insert, Some(NamedKey::Insert), Standard),
+        74 => (KeyCode::Home, Some(NamedKey::Home), Standard),
+        75 => (KeyCode::PageUp, Some(NamedKey::PageUp), Standard),
+        76 => (KeyCode::Delete, Some(NamedKey::Delete), Standard),
+        77 => (KeyCode::End, Some(NamedKey::End), Standard),
+        78 => (KeyCode::PageDown, Some(NamedKey::PageDown), Standard),
+        79 => (KeyCode::ArrowRight, Some(NamedKey::ArrowRight), Standard),
+        80 => (KeyCode::ArrowLeft, Some(NamedKey::ArrowLeft), Standard),
+        81 => (KeyCode::ArrowDown, Some(NamedKey::ArrowDown), Standard),
+        82 => (KeyCode::ArrowUp, Some(NamedKey::ArrowUp), Standard),
+        83 => (KeyCode::NumLock, Some(NamedKey::NumLock), Numpad),
+        84 => (KeyCode::NumpadDivide, None, Numpad),
+        85 => (KeyCode::NumpadMultiply, None, Numpad),
+        86 => (KeyCode::NumpadSubtract, None, Numpad),
+        87 => (KeyCode::NumpadAdd, None, Numpad),
+        88 => (KeyCode::NumpadEnter, Some(NamedKey::Enter), Numpad),
+        89..=98 => (numpad_digits[scancode as usize - 89], None, Numpad),
+        99 => (KeyCode::NumpadDecimal, None, Numpad),
+        100 => (KeyCode::IntlBackslash, None, Standard),
+        101 => (KeyCode::ContextMenu, Some(NamedKey::ContextMenu), Standard),
+        103 => (KeyCode::NumpadEqual, None, Numpad),
+        104 => (KeyCode::F13, Some(NamedKey::F13), Standard),
+        105 => (KeyCode::F14, Some(NamedKey::F14), Standard),
+        106 => (KeyCode::F15, Some(NamedKey::F15), Standard),
+        224 => (KeyCode::ControlLeft, Some(NamedKey::Control), Left),
+        225 => (KeyCode::ShiftLeft, Some(NamedKey::Shift), Left),
+        226 => (KeyCode::AltLeft, Some(NamedKey::Alt), Left),
+        227 => (KeyCode::SuperLeft, Some(NamedKey::Super), Left),
+        228 => (KeyCode::ControlRight, Some(NamedKey::Control), Right),
+        229 => (KeyCode::ShiftRight, Some(NamedKey::Shift), Right),
+        230 => (KeyCode::AltRight, Some(NamedKey::Alt), Right),
+        231 => (KeyCode::SuperRight, Some(NamedKey::Super), Right),
+        _ => return (PhysicalKey::Unidentified(NativeKeyCode::Unidentified), None, Standard),
+    };
+    (PhysicalKey::Code(code), named, location)
+}
+
+// SDL_Keymod bits, as the page sends them.
+const MOD_LSHIFT: i32 = 0x1;
+const MOD_RSHIFT: i32 = 0x2;
+const MOD_LCTRL: i32 = 0x40;
+const MOD_RCTRL: i32 = 0x80;
+const MOD_LALT: i32 = 0x100;
+const MOD_RALT: i32 = 0x200;
+const MOD_LGUI: i32 = 0x400;
+const MOD_RGUI: i32 = 0x800;
+
+fn modifiers(mods: i32) -> Modifiers {
+    let mut state = ModifiersState::empty();
+    let mut pressed = ModifiersKeys::empty();
+    for (left, right, s, l, r) in [
+        (MOD_LSHIFT, MOD_RSHIFT, ModifiersState::SHIFT, ModifiersKeys::LSHIFT, ModifiersKeys::RSHIFT),
+        (MOD_LCTRL, MOD_RCTRL, ModifiersState::CONTROL, ModifiersKeys::LCONTROL, ModifiersKeys::RCONTROL),
+        (MOD_LALT, MOD_RALT, ModifiersState::ALT, ModifiersKeys::LALT, ModifiersKeys::RALT),
+        (MOD_LGUI, MOD_RGUI, ModifiersState::SUPER, ModifiersKeys::LSUPER, ModifiersKeys::RSUPER),
+    ] {
+        state.set(s, mods & (left | right) != 0);
+        pressed.set(l, mods & left != 0);
+        pressed.set(r, mods & right != 0);
+    }
+    Modifiers { state, pressed_mods: pressed }
+}
+
+fn element_state(pressed: bool) -> event::ElementState {
+    if pressed {
+        event::ElementState::Pressed
+    } else {
+        event::ElementState::Released
+    }
+}
+
+/// What the loop knows of the page between events.
+struct EventState {
+    mods: i32,
+    scale: f64,
+}
+
+pub struct EventLoop<T> {
+    window_target: event_loop::ActiveEventLoop,
+    user_events_sender: mpsc::Sender<T>,
+    user_events_receiver: mpsc::Receiver<T>,
+    state: EventState,
+}
+
+impl<T: 'static> EventLoop<T> {
+    pub(crate) fn new(_: &PlatformSpecificEventLoopAttributes) -> Result<Self, EventLoopError> {
+        let (user_events_sender, user_events_receiver) = mpsc::channel();
+        Ok(Self {
+            window_target: event_loop::ActiveEventLoop {
+                p: ActiveEventLoop {
+                    control_flow: Cell::new(ControlFlow::default()),
+                    exit: Cell::new(false),
+                    windows: Arc::new(Mutex::new(Windows::default())),
+                },
+                _marker: PhantomData,
+            },
+            user_events_sender,
+            user_events_receiver,
+            state: EventState { mods: 0, scale: page().scale },
+        })
+    }
+
+    /// Turns the page's input events (8 words: kind, then per kind) into
+    /// winit's, for the most recent window (the page shows one).
+    fn pump<F>(&mut self, mut handler: F)
+    where
+        F: FnMut(event::Event<T>),
+    {
+        let Some(window_id) = self.window_target.p.windows.lock().unwrap().live.last().copied()
+        else {
+            // No window: leave the events for one.
+            return;
+        };
+        let window = |event| event::Event::WindowEvent { window_id: RootWindowId(window_id), event };
+        let device_id = event::DeviceId(DeviceId);
+        let mut raw = [0i32; 8];
+        // SAFETY: the import writes 8 words.
+        while unsafe { super::event_next(raw.as_mut_ptr()) } {
+            let f = |i: usize| f32::from_bits(raw[i] as u32) as f64;
+            match raw[0] {
+                // Key: scancode, down, repeat, modifiers, the key's character.
+                1 => {
+                    let pressed = raw[2] != 0;
+                    let (physical_key, named, location) = convert_scancode(raw[1] as u32);
+                    let character = char::from_u32(raw[5] as u32).filter(|&c| c != '\0');
+                    let mods = raw[4];
+                    let control = mods & (MOD_LCTRL | MOD_RCTRL | MOD_LGUI | MOD_RGUI) != 0;
+                    let (logical_key, key_without_modifiers) = match (named, character) {
+                        (Some(named), _) => (Key::Named(named), Key::Named(named)),
+                        (None, Some(c)) => {
+                            let s = SmolStr::from(c.encode_utf8(&mut [0; 4]));
+                            (Key::Character(s), Key::Character(SmolStr::from_iter(c.to_lowercase())))
+                        },
+                        (None, None) => (
+                            Key::Unidentified(NativeKey::Unidentified),
+                            Key::Unidentified(NativeKey::Unidentified),
+                        ),
+                    };
+                    let printable = character.filter(|c| !c.is_control());
+                    let text = printable.filter(|_| pressed && !control).map(|c| SmolStr::from(c.encode_utf8(&mut [0; 4])));
+                    let text_with_all_modifiers = match (pressed, printable, named) {
+                        (true, Some(c), _) if control && c.is_ascii_alphabetic() => Some(SmolStr::from(
+                            ((c.to_ascii_lowercase() as u8 - b'a' + 1) as char).encode_utf8(&mut [0; 4]),
+                        )),
+                        (true, Some(c), _) => Some(SmolStr::from(c.encode_utf8(&mut [0; 4]))),
+                        (true, None, Some(NamedKey::Enter)) => Some("\r".into()),
+                        (true, None, Some(NamedKey::Tab)) => Some("\t".into()),
+                        (true, None, Some(NamedKey::Backspace)) => Some("\u{8}".into()),
+                        (true, None, Some(NamedKey::Escape)) => Some("\u{1b}".into()),
+                        _ => None,
+                    };
+                    // Named keys with text (Enter, Tab, Space) carry it too.
+                    let text = text.or(match (pressed, named) {
+                        (true, Some(NamedKey::Enter)) => Some("\r".into()),
+                        (true, Some(NamedKey::Tab)) => Some("\t".into()),
+                        _ => None,
+                    });
+                    if mods != self.state.mods {
+                        self.state.mods = mods;
+                        handler(window(event::WindowEvent::ModifiersChanged(modifiers(mods))));
+                    }
+                    handler(window(event::WindowEvent::KeyboardInput {
+                        device_id,
+                        event: event::KeyEvent {
+                            physical_key,
+                            logical_key,
+                            text,
+                            location,
+                            state: element_state(pressed),
+                            repeat: raw[3] != 0,
+                            platform_specific: KeyEventExtra {
+                                key_without_modifiers,
+                                text_with_all_modifiers,
+                            },
+                        },
+                        is_synthetic: false,
+                    }));
+                    if let PhysicalKey::Code(code) = physical_key {
+                        handler(event::Event::DeviceEvent {
+                            device_id,
+                            event: event::DeviceEvent::Key(event::RawKeyEvent {
+                                physical_key: PhysicalKey::Code(code),
+                                state: element_state(pressed),
+                            }),
+                        });
+                    }
+                },
+                // Text: the key events carry it.
+                2 => {},
+                // Motion: x, y, dx, dy (CSS pixels, floats), buttons.
+                3 => {
+                    let scale = self.state.scale;
+                    handler(window(event::WindowEvent::CursorMoved {
+                        device_id,
+                        position: (f(1) * scale, f(2) * scale).into(),
+                    }));
+                    let delta = (f(3), f(4));
+                    if delta != (0.0, 0.0) {
+                        handler(event::Event::DeviceEvent {
+                            device_id,
+                            event: event::DeviceEvent::MouseMotion { delta },
+                        });
+                    }
+                },
+                // Button: SDL's button (1 left, 2 middle, 3 right, 4, 5), down.
+                4 => {
+                    let button = match raw[1] {
+                        1 => event::MouseButton::Left,
+                        2 => event::MouseButton::Middle,
+                        3 => event::MouseButton::Right,
+                        4 => event::MouseButton::Back,
+                        5 => event::MouseButton::Forward,
+                        n => event::MouseButton::Other(n as u16),
+                    };
+                    let state = element_state(raw[2] != 0);
+                    handler(window(event::WindowEvent::MouseInput { device_id, state, button }));
+                    handler(event::Event::DeviceEvent {
+                        device_id,
+                        event: event::DeviceEvent::Button { button: raw[1] as u32, state },
+                    });
+                },
+                // Wheel: dx, dy in lines (floats).
+                5 => {
+                    let delta = event::MouseScrollDelta::LineDelta(f(1) as f32, f(2) as f32);
+                    handler(window(event::WindowEvent::MouseWheel {
+                        device_id,
+                        delta,
+                        phase: event::TouchPhase::Moved,
+                    }));
+                    handler(event::Event::DeviceEvent {
+                        device_id,
+                        event: event::DeviceEvent::MouseWheel { delta },
+                    });
+                },
+                // Resize: CSS and pixel sizes.
+                6 => {
+                    let size = event::Event::WindowEvent {
+                        window_id: RootWindowId(window_id),
+                        event: event::WindowEvent::Resized(
+                            (raw[3].max(1) as u32, raw[4].max(1) as u32).into(),
+                        ),
+                    };
+                    let scale = page().scale;
+                    if scale != self.state.scale {
+                        self.state.scale = scale;
+                        let inner = Arc::new(Mutex::new(
+                            (raw[3].max(1) as u32, raw[4].max(1) as u32).into(),
+                        ));
+                        handler(window(event::WindowEvent::ScaleFactorChanged {
+                            scale_factor: scale,
+                            inner_size_writer: InnerSizeWriter::new(Arc::downgrade(&inner)),
+                        }));
+                    }
+                    handler(size);
+                    self.window_target.p.request_redraw(window_id);
+                },
+                7 => handler(window(event::WindowEvent::Focused(raw[1] != 0))),
+                8 => handler(window(if raw[1] != 0 {
+                    event::WindowEvent::CursorEntered { device_id }
+                } else {
+                    event::WindowEvent::CursorLeft { device_id }
+                })),
+                9 => handler(window(event::WindowEvent::CloseRequested)),
+                _ => {},
+            }
+        }
+    }
+
+    pub fn run<F>(mut self, mut event_handler_inner: F) -> Result<(), EventLoopError>
+    where
+        F: FnMut(event::Event<T>, &event_loop::ActiveEventLoop),
+    {
+        let mut start_cause = StartCause::Init;
+        loop {
+            event_handler_inner(event::Event::NewEvents(start_cause), &self.window_target);
+            if start_cause == StartCause::Init {
+                event_handler_inner(event::Event::Resumed, &self.window_target);
+            }
+
+            // New windows: their first size; closed ones.
+            let (created, destroyed) = {
+                let mut windows = self.window_target.p.windows.lock().unwrap();
+                (std::mem::take(&mut windows.created), std::mem::take(&mut windows.destroyed))
+            };
+            for id in created {
+                let size = page().pixels;
+                event_handler_inner(
+                    event::Event::WindowEvent {
+                        window_id: RootWindowId(id),
+                        event: event::WindowEvent::Resized(size.into()),
+                    },
+                    &self.window_target,
+                );
+            }
+            for id in destroyed {
+                event_handler_inner(
+                    event::Event::WindowEvent {
+                        window_id: RootWindowId(id),
+                        event: event::WindowEvent::Destroyed,
+                    },
+                    &self.window_target,
+                );
+            }
+
+            let mut events = Vec::new();
+            self.pump(|event| events.push(event));
+            for event in events {
+                event_handler_inner(event, &self.window_target);
+            }
+
+            while let Ok(event) = self.user_events_receiver.try_recv() {
+                event_handler_inner(event::Event::UserEvent(event), &self.window_target);
+            }
+
+            // To avoid deadlocks the lock is not held during event processing.
+            let redraws = std::mem::take(&mut self.window_target.p.windows.lock().unwrap().redraws);
+            for window_id in redraws {
+                event_handler_inner(
+                    event::Event::WindowEvent {
+                        window_id: RootWindowId(window_id),
+                        event: event::WindowEvent::RedrawRequested,
+                    },
+                    &self.window_target,
+                );
+            }
+
+            event_handler_inner(event::Event::AboutToWait, &self.window_target);
+
+            if self.window_target.p.exiting() {
+                break;
+            }
+
+            let requested_resume = match self.window_target.p.control_flow() {
+                ControlFlow::Poll => {
+                    start_cause = StartCause::Poll;
+                    continue;
+                },
+                ControlFlow::Wait => None,
+                ControlFlow::WaitUntil(instant) => Some(instant),
+            };
+            // No event to wait on: look again after a moment, or at the time asked.
+            let start = Instant::now();
+            let pending = !self.window_target.p.windows.lock().unwrap().redraws.is_empty();
+            let wait = match requested_resume {
+                _ if pending => Duration::ZERO,
+                Some(at) => at.saturating_duration_since(start).min(POLL),
+                None => POLL,
+            };
+            if !wait.is_zero() {
+                std::thread::sleep(wait);
+            }
+            start_cause = match requested_resume {
+                Some(requested_resume) if Instant::now() >= requested_resume => {
+                    StartCause::ResumeTimeReached { start, requested_resume }
+                },
+                _ => StartCause::WaitCancelled { start, requested_resume },
+            };
+        }
+
+        event_handler_inner(event::Event::LoopExiting, &self.window_target);
+        Ok(())
+    }
+
+    pub fn window_target(&self) -> &event_loop::ActiveEventLoop {
+        &self.window_target
+    }
+
+    pub fn create_proxy(&self) -> EventLoopProxy<T> {
+        EventLoopProxy { user_events_sender: self.user_events_sender.clone() }
+    }
+}
+
+pub struct EventLoopProxy<T: 'static> {
+    user_events_sender: mpsc::Sender<T>,
+}
+
+impl<T> EventLoopProxy<T> {
+    pub fn send_event(&self, event: T) -> Result<(), event_loop::EventLoopClosed<T>> {
+        self.user_events_sender.send(event).map_err(|mpsc::SendError(x)| event_loop::EventLoopClosed(x))
+    }
+}
+
+impl<T> Clone for EventLoopProxy<T> {
+    fn clone(&self) -> Self {
+        Self { user_events_sender: self.user_events_sender.clone() }
+    }
+}
+
+impl<T> Unpin for EventLoopProxy<T> {}
+
+/// The windows, shared with them: they ask for redraws and are dropped on
+/// any thread.
+#[derive(Default)]
+pub(super) struct Windows {
+    pub live: Vec<WindowId>,
+    pub created: Vec<WindowId>,
+    pub destroyed: Vec<WindowId>,
+    pub redraws: VecDeque<WindowId>,
+    pub next: u64,
+}
+
+pub struct ActiveEventLoop {
+    control_flow: Cell<ControlFlow>,
+    exit: Cell<bool>,
+    pub(super) windows: Arc<Mutex<Windows>>,
+}
+
+impl ActiveEventLoop {
+    fn request_redraw(&self, id: WindowId) {
+        let mut windows = self.windows.lock().unwrap();
+        if !windows.redraws.contains(&id) {
+            windows.redraws.push_back(id);
+        }
+    }
+
+    pub fn create_custom_cursor(&self, source: CustomCursorSource) -> RootCustomCursor {
+        let _ = source.inner;
+        RootCustomCursor { inner: super::PlatformCustomCursor }
+    }
+
+    pub fn primary_monitor(&self) -> Option<MonitorHandle> {
+        Some(MonitorHandle)
+    }
+
+    pub fn available_monitors(&self) -> VecDeque<MonitorHandle> {
+        VecDeque::from([MonitorHandle])
+    }
+
+    #[inline]
+    pub fn listen_device_events(&self, _allowed: DeviceEvents) {}
+
+    #[cfg(feature = "rwh_05")]
+    #[inline]
+    pub fn raw_display_handle_rwh_05(&self) -> rwh_05::RawDisplayHandle {
+        rwh_05::RawDisplayHandle::Web(rwh_05::WebDisplayHandle::empty())
+    }
+
+    #[inline]
+    pub fn system_theme(&self) -> Option<Theme> {
+        None
+    }
+
+    #[cfg(feature = "rwh_06")]
+    #[inline]
+    pub fn raw_display_handle_rwh_06(
+        &self,
+    ) -> Result<rwh_06::RawDisplayHandle, rwh_06::HandleError> {
+        Ok(rwh_06::RawDisplayHandle::Web(rwh_06::WebDisplayHandle::new()))
+    }
+
+    pub fn set_control_flow(&self, control_flow: ControlFlow) {
+        self.control_flow.set(control_flow)
+    }
+
+    pub fn control_flow(&self) -> ControlFlow {
+        self.control_flow.get()
+    }
+
+    pub(crate) fn exit(&self) {
+        self.exit.set(true);
+    }
+
+    pub(crate) fn exiting(&self) -> bool {
+        self.exit.get()
+    }
+
+    pub(crate) fn owned_display_handle(&self) -> OwnedDisplayHandle {
+        OwnedDisplayHandle
+    }
+}
+
+#[derive(Clone)]
+pub(crate) struct OwnedDisplayHandle;
+
+impl OwnedDisplayHandle {
+    #[cfg(feature = "rwh_05")]
+    #[inline]
+    pub fn raw_display_handle_rwh_05(&self) -> rwh_05::RawDisplayHandle {
+        rwh_05::WebDisplayHandle::empty().into()
+    }
+
+    #[cfg(feature = "rwh_06")]
+    #[inline]
+    pub fn raw_display_handle_rwh_06(
+        &self,
+    ) -> Result<rwh_06::RawDisplayHandle, rwh_06::HandleError> {
+        Ok(rwh_06::WebDisplayHandle::new().into())
+    }
+}
diff --git a/third_party/winit/src/platform_impl/wasi/mod.rs b/third_party/winit/src/platform_impl/wasi/mod.rs
