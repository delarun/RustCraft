+
+pub(super) fn features_from_web(names: &Value) -> wgpu::Features {
+    let names: Vec<&str> = names
+        .as_array()
+        .map(|a| a.iter().filter_map(Value::as_str).collect())
+        .unwrap_or_default();
+    let mut features = wgpu::Features::empty();
+    for (feature, name) in FEATURES {
+        if names.contains(&name) {
+            features |= feature;
+        }
+    }
+    features - UNUSED
+}
+
+pub(super) fn features_to_web(features: wgpu::Features) -> Vec<&'static str> {
+    FEATURES
+        .iter()
+        .filter(|(f, _)| features.contains(*f))
+        .map(|(_, name)| *name)
+        .collect()
+}
