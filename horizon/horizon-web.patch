+impl InstanceInterface for WebInstance {
+    fn new(_desc: wgpu::InstanceDescriptor) -> Self {
+        WebInstance
+    }
+
+    unsafe fn create_surface(
+        &self,
+        target: wgpu::SurfaceTargetUnsafe,
+    ) -> Result<DispatchSurface, wgpu::CreateSurfaceError> {
+        let wgpu::SurfaceTargetUnsafe::RawHandle {
+            raw_window_handle, ..
+        } = target
+        else {
+            panic!("the browser's surfaces are windows' canvases");
+        };
+        let raw_window_handle::RawWindowHandle::Web(web) = raw_window_handle else {
+            panic!("not a canvas: {raw_window_handle:?}");
+        };
+        // SAFETY: a plain value.
+        let id = unsafe { ffi::surface_create(web.id) };
+        Ok(DispatchSurface::custom(WebSurface {
+            h: handle(id),
+            configured: RefCell::new(None),
+        }))
+    }
