+pub(super) fn texture_view_dimension(d: wgpu::TextureViewDimension) -> &'static str {
+    match d {
+        wgpu::TextureViewDimension::D1 => "1d",
+        wgpu::TextureViewDimension::D2 => "2d",
+        wgpu::TextureViewDimension::D2Array => "2d-array",
+        wgpu::TextureViewDimension::Cube => "cube",
+        wgpu::TextureViewDimension::CubeArray => "cube-array",
+        wgpu::TextureViewDimension::D3 => "3d",
+    }
+}
+
+pub(super) fn texture_aspect(a: wgpu::TextureAspect) -> &'static str {
+    match a {
+        wgpu::TextureAspect::All => "all",
+        wgpu::TextureAspect::StencilOnly => "stencil-only",
+        wgpu::TextureAspect::DepthOnly => "depth-only",
+        other => panic!("WebGPU has no aspect {other:?}"),
+    }
+}
+
+pub(super) fn address_mode(m: wgpu::AddressMode) -> &'static str {
+    match m {
+        wgpu::AddressMode::ClampToEdge | wgpu::AddressMode::ClampToBorder => "clamp-to-edge",
+        wgpu::AddressMode::Repeat => "repeat",
+        wgpu::AddressMode::MirrorRepeat => "mirror-repeat",
+    }
+}
+
+pub(super) fn filter_mode(m: wgpu::FilterMode) -> &'static str {
+    match m {
+        wgpu::FilterMode::Nearest => "nearest",
+        wgpu::FilterMode::Linear => "linear",
+    }
+}
+
+pub(super) fn mipmap_filter_mode(m: wgpu::MipmapFilterMode) -> &'static str {
+    match m {
+        wgpu::MipmapFilterMode::Nearest => "nearest",
+        wgpu::MipmapFilterMode::Linear => "linear",
+    }
+}
+
+pub(super) fn compare_function(f: wgpu::CompareFunction) -> &'static str {
+    match f {
+        wgpu::CompareFunction::Never => "never",
+        wgpu::CompareFunction::Less => "less",
+        wgpu::CompareFunction::Equal => "equal",
+        wgpu::CompareFunction::LessEqual => "less-equal",
+        wgpu::CompareFunction::Greater => "greater",
+        wgpu::CompareFunction::NotEqual => "not-equal",
+        wgpu::CompareFunction::GreaterEqual => "greater-equal",
+        wgpu::CompareFunction::Always => "always",
+    }
+}
+
+pub(super) fn stencil_operation(op: wgpu::StencilOperation) -> &'static str {
+    match op {
+        wgpu::StencilOperation::Keep => "keep",
+        wgpu::StencilOperation::Zero => "zero",
+        wgpu::StencilOperation::Replace => "replace",
+        wgpu::StencilOperation::Invert => "invert",
+        wgpu::StencilOperation::IncrementClamp => "increment-clamp",
+        wgpu::StencilOperation::DecrementClamp => "decrement-clamp",
+        wgpu::StencilOperation::IncrementWrap => "increment-wrap",
+        wgpu::StencilOperation::DecrementWrap => "decrement-wrap",
+    }
+}
+
+pub(super) fn blend_factor(f: wgpu::BlendFactor) -> &'static str {
+    use wgpu::BlendFactor as B;
+    match f {
+        B::Zero => "zero",
+        B::One => "one",
+        B::Src => "src",
+        B::OneMinusSrc => "one-minus-src",
+        B::SrcAlpha => "src-alpha",
+        B::OneMinusSrcAlpha => "one-minus-src-alpha",
+        B::Dst => "dst",
+        B::OneMinusDst => "one-minus-dst",
+        B::DstAlpha => "dst-alpha",
+        B::OneMinusDstAlpha => "one-minus-dst-alpha",
+        B::SrcAlphaSaturated => "src-alpha-saturated",
+        B::Constant => "constant",
+        B::OneMinusConstant => "one-minus-constant",
+        B::Src1 => "src1",
+        B::OneMinusSrc1 => "one-minus-src1",
+        B::Src1Alpha => "src1-alpha",
+        B::OneMinusSrc1Alpha => "one-minus-src1-alpha",
+    }
+}
+
+pub(super) fn blend_operation(op: wgpu::BlendOperation) -> &'static str {
+    match op {
+        wgpu::BlendOperation::Add => "add",
+        wgpu::BlendOperation::Subtract => "subtract",
+        wgpu::BlendOperation::ReverseSubtract => "reverse-subtract",
+        wgpu::BlendOperation::Min => "min",
+        wgpu::BlendOperation::Max => "max",
+    }
+}
+
+pub(super) fn primitive_topology(t: wgpu::PrimitiveTopology) -> &'static str {
+    match t {
+        wgpu::PrimitiveTopology::PointList => "point-list",
+        wgpu::PrimitiveTopology::LineList => "line-list",
+        wgpu::PrimitiveTopology::LineStrip => "line-strip",
+        wgpu::PrimitiveTopology::TriangleList => "triangle-list",
+        wgpu::PrimitiveTopology::TriangleStrip => "triangle-strip",
+    }
+}
+
+pub(super) fn index_format(f: wgpu::IndexFormat) -> &'static str {
+    match f {
+        wgpu::IndexFormat::Uint16 => "uint16",
+        wgpu::IndexFormat::Uint32 => "uint32",
+    }
+}
+
+pub(super) fn store_op(op: wgpu::StoreOp) -> &'static str {
+    match op {
+        wgpu::StoreOp::Store => "store",
+        wgpu::StoreOp::Discard => "discard",
+    }
+}
+
+pub(super) fn bind_group_layout_entry(entry: &wgpu::BindGroupLayoutEntry) -> Value {
+    let mut out = json!({ "binding": entry.binding, "visibility": entry.visibility.bits() & 7 });
+    match entry.ty {
+        wgpu::BindingType::Buffer {
+            ty,
+            has_dynamic_offset,
+            min_binding_size,
+        } => {
+            out["buffer"] = json!({
+                "type": match ty {
+                    wgpu::BufferBindingType::Uniform => "uniform",
+                    wgpu::BufferBindingType::Storage { read_only: true } => "read-only-storage",
+                    wgpu::BufferBindingType::Storage { read_only: false } => "storage",
+                },
+                "hasDynamicOffset": has_dynamic_offset,
+                "minBindingSize": min_binding_size.map_or(0, |s| s.get()),
+            });
+        }
+        wgpu::BindingType::Sampler(ty) => {
+            out["sampler"] = json!({
+                "type": match ty {
+                    wgpu::SamplerBindingType::Filtering => "filtering",
+                    wgpu::SamplerBindingType::NonFiltering => "non-filtering",
+                    wgpu::SamplerBindingType::Comparison => "comparison",
+                },
+            });
+        }
+        wgpu::BindingType::Texture {
+            sample_type,
+            view_dimension,
+            multisampled,
+        } => {
+            out["texture"] = json!({
+                "sampleType": match sample_type {
+                    wgpu::TextureSampleType::Float { filterable: true } => "float",
+                    wgpu::TextureSampleType::Float { filterable: false } => "unfilterable-float",
+                    wgpu::TextureSampleType::Depth => "depth",
+                    wgpu::TextureSampleType::Sint => "sint",
+                    wgpu::TextureSampleType::Uint => "uint",
+                },
+                "viewDimension": texture_view_dimension(view_dimension),
+                "multisampled": multisampled,
+            });
+        }
+        wgpu::BindingType::StorageTexture {
+            access,
+            format,
+            view_dimension,
+        } => {
+            out["storageTexture"] = json!({
+                "access": match access {
+                    wgpu::StorageTextureAccess::WriteOnly => "write-only",
+                    wgpu::StorageTextureAccess::ReadOnly => "read-only",
+                    wgpu::StorageTextureAccess::ReadWrite => "read-write",
+                    other => panic!("WebGPU has no storage access {other:?}"),
+                },
+                "format": texture_format(format),
+                "viewDimension": texture_view_dimension(view_dimension),
+            });
+        }
+        other => panic!("WebGPU has no binding {other:?}"),
+    }
+    out
+}
+
+pub(super) fn buffer_layout(layout: &wgpu::TexelCopyBufferLayout) -> Value {
+    json!({
+        "offset": layout.offset,
+        "bytesPerRow": layout.bytes_per_row,
+        "rowsPerImage": layout.rows_per_image,
+    })
+}
+
+pub(super) fn buffer_copy(copy: &wgpu::TexelCopyBufferInfo<'_>) -> Value {
+    let mut out = buffer_layout(&copy.layout);
+    out["buffer"] = json!(
+        copy.buffer
+            .as_custom::<WebBuffer>()
+            .expect("not a web buffer")
+            .h
+            .0
+    );
+    out
+}
+
+pub(super) fn texture_copy(copy: &wgpu::TexelCopyTextureInfo<'_>) -> Value {
+    json!({
+        "texture": copy.texture.as_custom::<WebTexture>().expect("not a web texture").h.0,
+        "mipLevel": copy.mip_level,
+        "origin": [copy.origin.x, copy.origin.y, copy.origin.z],
+        "aspect": texture_aspect(copy.aspect),
+    })
+}
