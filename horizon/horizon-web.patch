+/// WebGPU's limits by name, with wgpu's fields.
+macro_rules! limits {
+    ($($js:literal => $rs:ident),* $(,)?) => {
+        pub(super) fn limits_from_web(limits: &Value) -> wgpu::Limits {
+            let mut out = wgpu::Limits::downlevel_defaults();
+            $(
+                if let Some(v) = limits[$js].as_f64() {
+                    out.$rs = v as _;
+                }
+            )*
+            out.max_immediate_size = 0;
+            out
+        }
+
+        pub(super) fn limits_to_web(limits: &wgpu::Limits) -> Value {
+            json!({ $($js: limits.$rs as f64,)* })
+        }
+    };
+}
